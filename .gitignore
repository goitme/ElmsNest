# Reproducible binary asset pack — regenerate with: cd brief/assets && python3 fetch.py
brief/assets/img/
brief/assets/fonts/
# Agent screenshots (large 2x PNGs); the mockup HTML itself is committed
brief/concepts/**/*.png
brief/build-preview/**/*.png
node_modules/
# Inventory mirrors of the dev theme (brief/inventory/mirror-all.sh regenerates them): keep index.html + logs summary, drop assets/cookies/2x PNGs
brief/inventory/**/a/
brief/inventory/**/cj.txt
brief/inventory/**/*.log
brief/inventory/**/*.png
brief/inventory/**/sheet-*.jpg
brief/inventory/theme-src/templates/page.store-locator.json
brief/side-pages/**/*.png

# SIMPLIFY verification mirrors (regenerated by verify-mirror.js; ~170 MB per run)
brief/side-pages/simplify/verify-*/mirrors/
brief/side-pages/simplify/verify-*/jar.txt
