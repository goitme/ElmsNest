{%- comment -%}
  Floating WhatsApp entry — the operational proof of "שאלה לפני הזמנה".

  Renders NOTHING until settings.whatsapp_number is filled in theme settings
  (ElmsNest group). A WhatsApp button that nobody answers is worse than no
  button, so the gate is deliberate: the surface may not promise a channel
  that does not exist yet.

  WhatsApp green is the one brand-external colour allowed on the page —
  instant recognition is the button's entire function, and a recoloured
  WhatsApp button reads as a fake one. The shape stays square, like every
  other control in the spec-sheet world.
{%- endcomment -%}

{%- assign en_wa = settings.whatsapp_number | default: '' | strip | remove: ' ' | remove: '-' | remove: '+' | remove: '(' | remove: ')' -%}
{%- if en_wa != blank -%}
<a
  class="en-wa"
  href="https://wa.me/{{ en_wa }}"
  target="_blank"
  rel="noopener"
  dir="rtl"
  aria-label="שאלות לפני ההזמנה בוואטסאפ"
>
  <svg class="en-wa__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
  </svg>
  <span class="en-wa__label">שאלות? וואטסאפ</span>
</a>
<style>
  .en-wa{
    position:fixed;bottom:18px;left:18px;z-index:60;
    display:inline-flex;align-items:center;gap:10px;
    min-height:54px;padding:13px 18px;border-radius:0;
    background:#25d366;border:1px solid rgba(0,0,0,.14);
    color:#fff!important;text-decoration:none;
    font-weight:600;font-size:15px;line-height:1;
    transition:background-color .18s ease
  }
  .en-wa:hover{background:#1ebe5b;color:#fff!important}
  .en-wa:focus-visible{outline:3px solid #fff;outline-offset:-6px}
  .en-wa__icon{flex:0 0 auto}
  @media(max-width:640px){
    .en-wa{padding:0;width:54px;justify-content:center}
    .en-wa__label{display:none}
  }
  @media print{.en-wa{display:none}}
</style>
{%- endif -%}
