{% comment %}
  ElmsNest measurement preview.

  This snippet is installed only on the unpublished development theme.
  Google consent defaults to denied until the store's consent layer sends
  an explicit update. The GTM workspace must remain unpublished until QA and
  live-release approval are complete.
{% endcomment %}

{%- case placement -%}
  {%- when 'head' -%}
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
    </script>
    <!-- Google Tag Manager: unpublished measurement preview -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NCK2MKW2');</script>
    <!-- End Google Tag Manager -->
  {%- when 'body' -%}
    <!-- Google Tag Manager (noscript): unpublished measurement preview -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NCK2MKW2"
    height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
{%- endcase -%}
