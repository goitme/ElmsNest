{%- comment -%}
  ElmsNest PDP — שאלות ותשובות (v2).

  v1 היה שורות של 16px על קווי שיער דקים, בלי כותרת־על ובלי סימן פתיחה קריא —
  המקטע פשוט נעלם בתוך העמוד. v2 בונה אותו כלהקת תוכן מלאה: כותרת מקטע של 46px,
  שאלות של 20px במשקל 600 בשורות של 76px, וסימן +/− בגודל 52px שהוא הנכס החזותי
  של המקטע (אין כאן תמונה — הטיפוגרפיה והסימן נושאים את הלהקה).

  שני מקורות, אקורדיון אחד — נבחר בהגדרה "מקור השאלות":
    · metafield — שדה custom.faq של המוצר עצמו (מערך JSON של {q, a}), כך שכל
      מוצר עונה על השאלות שלו
    · blocks    — שאלות שנכתבות בעורך הערכה ומופיעות בכל המוצרים
    · both      — קודם שאלות המוצר, אחריהן הקבועות

  הסימון נשאר <details>/<summary> מקורי: Tab מגיע אליו, Enter ו־Space פותחים
  וסוגרים, והוא עובד גם בלי JavaScript. הקובץ elms-pdp-faq.js רק משקף את מצב
  הפתיחה אל aria-expanded — ולכן שמות המחלקות elms-faq__item ו־elms-faq__summary
  נשמרו בדיוק, הם החוזה מולו.

  כל תכונת CSS תלוית־כיוון היא לוגית — החנות בעברית RTL. סיבוב הסימן נעשה על
  פס ממורכז וסימטרי (90° ← 0°), ולכן הוא נראה זהה ב־RTL וב־LTR.
{%- endcomment -%}

{%- liquid
  assign elms_faq_source = section.settings.source
  assign elms_faq_mf = product.metafields.custom.faq.value

  assign elms_faq_mf_count = 0
  if elms_faq_source != 'blocks' and elms_faq_mf != blank
    assign elms_faq_mf_count = elms_faq_mf.size
  endif

  assign elms_faq_block_count = 0
  if elms_faq_source != 'metafield'
    for block in section.blocks
      if block.settings.question != blank and block.settings.answer != blank
        assign elms_faq_block_count = elms_faq_block_count | plus: 1
      endif
    endfor
  endif

  assign elms_faq_total = elms_faq_mf_count | plus: elms_faq_block_count
-%}

{%- if section.settings.enable and elms_faq_total > 0 -%}
  <section
    class="elms-pdp elms-faq elms-faq--{{ section.settings.ground }}"
    dir="rtl"
    {% if section.settings.heading != blank %}
      aria-labelledby="elms-faq-title-{{ section.id }}"
    {% else %}
      aria-label="שאלות ותשובות"
    {% endif %}
    style="--elms-faq-pt: {{ section.settings.padding_top }}px; --elms-faq-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="elms-faq__wrap">
      {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <header class="elms-faq__header">
          {%- if section.settings.kicker != blank -%}
            <p class="elms-faq__kicker">{{ section.settings.kicker }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="elms-faq__title" id="elms-faq-title-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="elms-faq__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="elms-faq__list">
        {%- if elms_faq_mf_count > 0 -%}
          {%- for elms_qa in elms_faq_mf -%}
            {%- if elms_qa.q != blank and elms_qa.a != blank -%}
              <details class="elms-faq__item">
                <summary class="elms-faq__summary" aria-expanded="false">
                  <h3 class="elms-faq__q">{{ elms_qa.q }}</h3>
                  <span class="elms-faq__mark" aria-hidden="true">
                    <span class="elms-faq__bar"></span>
                    <span class="elms-faq__bar elms-faq__bar--cross"></span>
                  </span>
                </summary>
                <div class="elms-faq__a">
                  <p>{{ elms_qa.a }}</p>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if elms_faq_block_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank and block.settings.answer != blank -%}
              <details class="elms-faq__item" {{ block.shopify_attributes }}>
                <summary class="elms-faq__summary" aria-expanded="false">
                  <h3 class="elms-faq__q">{{ block.settings.question }}</h3>
                  <span class="elms-faq__mark" aria-hidden="true">
                    <span class="elms-faq__bar"></span>
                    <span class="elms-faq__bar elms-faq__bar--cross"></span>
                  </span>
                </summary>
                <div class="elms-faq__a">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="elms-faq__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>

  <script src="{{ 'elms-pdp-faq.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  .elms-faq,
  .elms-faq * { box-sizing: border-box; }

  .elms-faq {
    direction: rtl;
    /* 64px היא רצפת המקצב של המפרט. ההגדרה של הסוחר יכולה רק להוסיף עליה, כך
       שערך ישן של 56px לא מחזיר את הלהקה לצפיפות של v1. */
    padding-block-start: max(var(--elms-faq-pt), 64px);
    padding-block-end: max(var(--elms-faq-pb), 64px);
    padding-inline: clamp(16px, 3vw, 32px);
  }

  /* --- Grounds. Amber is an accent only: kicker rule, open edge, open mark. */

  .elms-faq--cream {
    background: rgb(var(--en-surface-page));
    color: rgb(var(--en-text-primary));
    --elms-faq-fg: rgb(var(--en-text-primary));
    --elms-faq-kicker: rgb(var(--en-text-muted));
    --elms-faq-soft: rgb(var(--en-text-secondary));
    --elms-faq-note: rgb(var(--en-text-muted));
    --elms-faq-rule: rgb(var(--en-border-subtle));
    --elms-faq-chip: rgb(var(--en-surface-card));
    --elms-faq-panel: rgb(var(--en-surface-card));
    --elms-faq-accent: rgb(var(--en-amber));
    --elms-faq-open-bg: rgb(var(--en-amber-soft));
    --elms-faq-open-fg: rgb(var(--en-text-primary));
    --elms-faq-focus: rgb(var(--en-text-primary));
  }

  .elms-faq--night {
    background: rgb(var(--en-night));
    color: rgb(var(--en-ink));
    --elms-faq-fg: rgb(var(--en-ink));
    --elms-faq-kicker: rgb(var(--en-amber));
    --elms-faq-soft: rgb(var(--en-ink) / .72);
    --elms-faq-note: rgb(var(--en-ink) / .60);
    --elms-faq-rule: rgb(var(--en-ink) / .16);
    --elms-faq-chip: rgb(var(--en-ink) / .06);
    --elms-faq-panel: rgb(var(--en-ink) / .04);
    --elms-faq-accent: rgb(var(--en-amber));
    --elms-faq-open-bg: rgb(var(--en-amber));
    --elms-faq-open-fg: rgb(var(--en-night));
    --elms-faq-focus: rgb(var(--en-ink));
  }

  .elms-faq__wrap {
    inline-size: min(1180px, 100%);
    margin-inline: auto;
  }

  /* --- Header: kicker / title / sub. Ratio title:body is 46:16 = 2.9x. ---- */

  /* Line length is capped per element in `em`, never in `ch` on the header:
     `ch` resolves against the containing block's font-size (16px), so a cap on
     the header clamped the whole band to ~500px of an 1180px container and
     folded the 46px title into a ribbon. `em` follows each element's own size. */
  .elms-faq__header {
    margin-block-end: clamp(32px, 4vw, 56px);
  }

  .elms-faq__kicker {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: .10em;
    color: var(--elms-faq-kicker);
  }

  .elms-faq__kicker::after {
    content: "";
    display: block;
    inline-size: 40px;
    block-size: 2px;
    margin-block-start: 12px;
    background: var(--elms-faq-accent);
  }

  /* The theme sets its own h2/h3 colour and size, which beat plain inheritance
     from the section root — so every heading here states both explicitly. */
  .elms-faq__title {
    margin: 0;
    max-inline-size: 14em;
    color: var(--elms-faq-fg);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -.01em;
    text-wrap: balance;
  }

  .elms-faq__sub {
    margin: 16px 0 0;
    max-inline-size: 32em;
    font-size: clamp(16px, 1.3vw, 19px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--elms-faq-soft);
    text-align: start;
  }

  /* --- Rows. 76px minimum so a closed list still reads as a stack of doors. */

  .elms-faq__list {
    border-block-start: 1px solid var(--elms-faq-rule);
  }

  .elms-faq__item {
    border-block-end: 1px solid var(--elms-faq-rule);
    /* Always present and transparent, so opening never shifts the text. */
    border-inline-start: 3px solid transparent;
    padding-inline: clamp(12px, 1.6vw, 22px);
    transition: background-color .18s ease, border-color .18s ease;
  }

  .elms-faq__item[open] {
    background: var(--elms-faq-panel);
    border-inline-start-color: var(--elms-faq-accent);
  }

  .elms-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 2vw, 28px);
    min-block-size: 76px;
    padding-block: 16px;
    cursor: pointer;
    list-style: none;
  }

  .elms-faq__summary::-webkit-details-marker { display: none; }
  .elms-faq__summary::marker { content: ''; }

  .elms-faq__q {
    display: block;
    margin: 0;
    color: var(--elms-faq-fg);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.35;
    text-align: start;
    text-wrap: pretty;
  }

  /* --- The indicator is this band's visual asset: 52px, no image needed. --- */

  .elms-faq__mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    inline-size: 52px;
    block-size: 52px;
    border: 1px solid var(--elms-faq-rule);
    background: var(--elms-faq-chip);
    color: var(--elms-faq-fg);
    transition: background-color .2s ease, border-color .2s ease, color .2s ease;
  }

  /* Both bars share one grid cell and are centred, so the cross bar rotates
     about its own middle: 90deg (a plus) to 0deg (a minus). A centred,
     symmetric bar looks identical under RTL and LTR — no direction flip. */
  .elms-faq__bar {
    grid-area: 1 / 1;
    inline-size: 22px;
    block-size: 2px;
    background: currentColor;
  }

  .elms-faq__bar--cross {
    transform: rotate(90deg);
    transition: transform .24s ease;
  }

  .elms-faq__item[open] .elms-faq__mark {
    background: var(--elms-faq-open-bg);
    border-color: var(--elms-faq-accent);
    color: var(--elms-faq-open-fg);
  }

  .elms-faq__item[open] .elms-faq__bar--cross {
    transform: rotate(0deg);
  }

  /* --- Answers ------------------------------------------------------------ */

  .elms-faq__a {
    max-inline-size: 34em;
    padding-block: 2px clamp(22px, 2.4vw, 30px);
  }

  .elms-faq__a p,
  .elms-faq__a li {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--elms-faq-soft);
    text-align: start;
  }

  .elms-faq__a p:last-child,
  .elms-faq__a li:last-child { margin-block-end: 0; }

  .elms-faq__a ul,
  .elms-faq__a ol {
    margin: 0 0 10px;
    padding-inline-start: 1.2em;
  }

  .elms-faq__a strong {
    font-weight: 600;
    color: var(--elms-faq-fg);
  }

  .elms-faq__a a {
    color: var(--elms-faq-fg);
    text-underline-offset: 3px;
  }

  .elms-faq__note {
    margin-block-start: clamp(28px, 3vw, 40px);
    padding-block-start: 18px;
    border-block-start: 1px solid var(--elms-faq-rule);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--elms-faq-note);
  }

  .elms-faq__summary:focus-visible {
    outline: 3px solid var(--elms-faq-focus);
    outline-offset: -4px;
  }

  @media (hover: hover) {
    .elms-faq__summary:hover .elms-faq__mark { border-color: var(--elms-faq-accent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .elms-faq__item,
    .elms-faq__mark,
    .elms-faq__bar--cross { transition: none; }
  }

  @media (max-width: 760px) {
    .elms-faq {
      padding-block-start: max(calc(var(--elms-faq-pt) * .68), 48px);
      padding-block-end: max(calc(var(--elms-faq-pb) * .68), 48px);
      padding-inline: 16px;
    }
    .elms-faq__item { padding-inline: 10px; }
    .elms-faq__summary { gap: 14px; min-block-size: 68px; }
    .elms-faq__mark { inline-size: 44px; block-size: 44px; }
    .elms-faq__bar { inline-size: 18px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP · שאלות ותשובות",
  "tag": "section",
  "class": "elms-pdp-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "הצגת המקטע",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "שורת פתיחה קצרה",
      "info": "מופיעה מעל הכותרת. השאירו ריק כדי להסתיר.",
      "default": "לפני שמזמינים"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת המקטע",
      "default": "שאלות ותשובות"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "שורת משנה",
      "info": "השאירו ריק כדי להסתיר.",
      "default": "מה שנשאלנו הכי הרבה על ההזמנה, המשלוח וההתקנה — במקום אחד."
    },
    {
      "type": "select",
      "id": "source",
      "label": "מקור השאלות",
      "info": "שאלות המוצר נלקחות משדה המטא custom.faq של אותו מוצר. שאלות קבועות נכתבות כאן ומופיעות בכל המוצרים.",
      "options": [
        { "value": "metafield", "label": "שאלות המוצר בלבד" },
        { "value": "blocks", "label": "שאלות קבועות בלבד" },
        { "value": "both", "label": "שאלות המוצר ואחריהן הקבועות" }
      ],
      "default": "both"
    },
    {
      "type": "text",
      "id": "note",
      "label": "הערה בתחתית המקטע",
      "default": "לא מצאתם תשובה? שלחו לנו הודעה לפני שאתם מזמינים."
    },
    {
      "type": "header",
      "content": "עיצוב"
    },
    {
      "type": "select",
      "id": "ground",
      "label": "רקע המקטע",
      "info": "העמוד מתחלף בין רקע בהיר לרקע לילי. אין להשאיר יותר משתי להקות בהירות ברצף.",
      "options": [
        { "value": "cream", "label": "בהיר" },
        { "value": "night", "label": "לילי כהה" }
      ],
      "default": "cream"
    },
    {
      "type": "header",
      "content": "ריווח"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "ריווח עליון",
      "info": "המינימום בפועל הוא 64 פיקסלים, גם אם נבחר ערך נמוך יותר.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "ריווח תחתון",
      "info": "המינימום בפועל הוא 64 פיקסלים, גם אם נבחר ערך נמוך יותר.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "צבעים מהגרסה הקודמת (אינם בשימוש)"
    },
    {
      "type": "paragraph",
      "content": "שתי ההגדרות הבאות נשמרו כדי שערכים שנשמרו בעבר לא יישברו. הצבעים נקבעים עכשיו לפי הבחירה ברקע המקטע ולפי צבעי המותג."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "צבע רקע (ישן)",
      "default": "#FFFDF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "צבע טקסט (ישן)",
      "default": "#2B2118"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "שאלה קבועה",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "השאלה"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "התשובה",
          "info": "אין להתחייב על נתון שאינו מפורסם בעמוד המוצר."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP · שאלות ותשובות",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "מתי ההזמנה מגיעה?",
            "answer": "<p>הזמן הכולל המשוער ממועד ההזמנה הוא 8–17 ימי עסקים: 1–3 ימי טיפול ועוד 7–14 ימי משלוח. משלוח לנקודת איסוף בישראל — חינם; שליח עד הבית — 29.90 ₪.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "אפשר לבטל את ההזמנה?",
            "answer": "<p>ניתן למסור הודעת ביטול עד 14 ימים ממועד קבלת המוצר, בהתאם לחוק הגנת הצרכן ולמדיניות הביטולים וההחזרים.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "איך אדע שהמוצר מתאים למקום שלי?",
            "answer": "<p>בדקו במפרט הטכני את אופן ההפעלה, המידות ודרגת העמידות. אם פרט חסר — שלחו לנו הודעה לפני ההזמנה ונבדוק יחד.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
