;transition:transform 1.2s ease}.elms-feeling-hero__content{position:absolute;z-index:1;right:clamp(24px,6vw,90px);bottom:clamp(32px,7vw,90px);width:min(620px,calc(100% - 48px));color:#fff;text-align:right;text-shadow:0 3px 22px rgba(0,0,0,.38)}.elms-feeling-hero__eyebrow{display:inline-flex;align-items:center;gap:9px;margin-bottom:16px;color:#f1d7a4;font-size:13px;font-weight:700;line-height:1.3;letter-spacing:.08em}.elms-feeling-hero__eyebrow:before{content:\"\";width:32px;height:1px;background:currentColor}.elms-feeling-hero__title{max-width:580px;margin:0 0 16px;color:#fff;font-size:clamp(40px,5.2vw,72px);font-weight:800;line-height:1.02;letter-spacing:-.045em}.elms-feeling-hero__text{max-width:550px;margin:0;color:rgba(255,255,255,.92);font-size:clamp(17px,1.7vw,22px);line-height:1.65}@media(hover:hover){.elms-feeling-hero:hover .elms-feeling-hero__image{transform:scale(1.025)}}@media(max-width:749px){.elms-feeling-hero{width:calc(100% - 20px);min-height:580px;margin:24px auto;border-radius:18px}.elms-feeling-hero:before{background:linear-gradient(0deg,rgba(7,8,6,.78),rgba(7,8,6,.38) 42%,rgba(7,8,6,.03) 74%)}.elms-feeling-hero__image{object-position:46% center}.elms-feeling-hero__content{right:22px;bottom:34px;width:calc(100% - 44px)}.elms-feeling-hero__eyebrow{margin-bottom:12px;font-size:11px}.elms-feeling-hero__title{margin-bottom:13px;font-size:39px;line-height:1.08}.elms-feeling-hero__text{max-width:340px;font-size:16px;line-height:1.6}}@media(prefers-reduced-motion:reduce){.elms-feeling-hero__image{transition:none}}\n</style>",
