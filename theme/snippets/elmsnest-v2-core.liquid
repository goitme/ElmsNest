<script>document.documentElement.classList.add('env2-js');</script>
{%- comment -%}
  ElmsNest v2 — shared CORE (WINNING-SPEC §3.1 palette, §3.3 spacing, §3.4 motion, §3.5 plumbing).
  Rendered ONCE per page by layout/theme.liquid, in <head>, after css-variables and after elmsnest-v2-fonts
  (the --env2-sans/--env2-serif tokens come from the fonts snippet):
    render 'elmsnest-v2-fonts'
    render 'elmsnest-v2-core'
  Line 1 above must stay the first line: it adds html.env2-js BEFORE any section paints,
  so lamps start dim only when JS is actually running (no-JS = everything lit).
  Page-agnostic: the index dusk gradient lives in elmsnest-v2-ground-index (rendered by the hero).
  Everything here is prefixed env2-. Nothing is per-instance, so no Liquid below.
{%- endcomment -%}
<style id="env2-base">
/* ---------- tokens (§3.1) ---------- */
:root{
  --env2-sky-0:#4a6a9c;--env2-sky-1:#1f3357;--env2-sky-2:#0f1a2f;--env2-sky-3:#070b15;--env2-sky-4:#020306;
  --env2-ink:#f4eee3;--env2-ink-2:#c9c4b8;--env2-mute:#8f95a3;
  --env2-gold:#e9b96e;--env2-glow:#ffd394;--env2-ember:#f7a24a;--env2-btn-ink:#1a1206;
  --env2-hair:rgba(244,238,227,.12);--env2-hair-btn:rgba(244,238,227,.25);--env2-hair-num:rgba(244,238,227,.45);
  --env2-scrim:rgba(5,8,14,.55);
  --env2-gut:clamp(20px,4vw,64px);--env2-w:1240px;
  --env2-p:0;--p:0;
}

/* ---------- page ground (§3.1), every template ----------
   Kalles paints body with its scheme and wraps content in painted containers; here the document
   is night on every page type and the wrappers go clear. The index keeps its own dusk gradient
   (snippets/elmsnest-v2-ground-index, rendered by the hero); every other template gets the
   side-page ground: sky-2 -> sky-3 -> sky-4, ending in #020306 before the footer. */
html{background:#020306}
body[class*="hdt-page-type-"]{background-color:#020306;color:#f4eee3}
body[class*="hdt-page-type-"]:not(.hdt-page-type-index){
  background-image:linear-gradient(180deg,#0f1a2f 0%,#070b15 45%,#020306 100%);
  background-repeat:no-repeat;background-size:100% 100%;background-attachment:scroll;
  min-height:100vh;
}
#wrapper,.main-content,main,#MainContent,.hdt-main-content,.hdt-page-content,.shopify-section{background:transparent}
/* Kalles back-to-top: a white square bottom-right (old palette) — hidden everywhere (§7.11) */
.hdt-back-to-top,back-to-top{display:none!important}
/* Kalles footer group: same sans as the page, quiet links (underline on hover only) */
.shopify-section-group-footer-group{font-family:var(--env2-sans)}
.shopify-section-group-footer-group a{text-decoration:none}
.shopify-section-group-footer-group a:hover,.shopify-section-group-footer-group a:focus-visible{text-decoration:underline}
/* Kalles chrome type: header menu, drawers, popovers, facets and the old sections use Heebo.
   css-variables sets --f_family_1..3 on :root from the Shopify font (assistant_n4); this comes after it. */
:root{--f_family_1:var(--env2-sans);--f_family_2:var(--env2-sans);--f_family_3:var(--env2-sans)}
/* interim (until the collection is rebuilt, round 2): sort entries that imply sales data are hidden;
   sale badges never render (settings hidden_badges + this belt) */
option[value="best-selling"],hdt-richlist button[role="option"][value="best-selling"]{display:none}
.hdt-badge__wrapp{display:none}

/* ---------- section root helper + container (§3.3) ---------- */
.env2-section{position:relative;background:transparent;color:var(--env2-ink);font-family:var(--env2-sans);font-weight:300;font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:clip;direction:rtl;text-align:start}
.env2-section img{display:block;max-width:100%}
.env2-section a{color:inherit;text-decoration:none}
.env2-section bdi{unicode-bidi:isolate}
.env2-section :focus-visible{outline:2px solid var(--env2-glow);outline-offset:4px}
.env2-wrap{width:min(var(--env2-w),100% - 2*var(--env2-gut));margin-inline:auto}
.env2-wrap--wide{width:min(1500px,100% - 2*var(--env2-gut));margin-inline:auto}

/* ---------- type helpers (§3.2) ---------- */
.env2-h{font-family:var(--env2-serif);font-weight:700;line-height:.98;letter-spacing:-.01em;text-wrap:balance;margin:0;color:var(--env2-ink)}
.env2-h em,.env2-h .env2-glow{font-style:normal;color:var(--env2-glow)}
.env2-serif{font-family:var(--env2-serif)}
.env2-lead{font-family:var(--env2-sans);font-weight:300;font-size:clamp(17px,1.4vw,21px);line-height:1.5;max-width:38ch;color:var(--env2-ink-2);margin:0}
.env2-eyebrow{display:flex;align-items:center;gap:14px;margin:0;font-family:var(--env2-sans);font-size:12px;font-weight:500;line-height:1.3;letter-spacing:.18em;text-transform:uppercase;color:var(--env2-gold)}
.env2-eyebrow::before{content:"";flex:none;width:34px;height:1px;background:var(--env2-gold);opacity:.8}
.env2-eyebrow--ink{color:var(--env2-ink)}
.env2-kicker{font-family:var(--env2-sans);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--env2-gold)}
.env2-price{font-family:var(--env2-serif);font-weight:500;font-variant-numeric:tabular-nums;font-size:var(--env2-price-size,24px);line-height:1.1;color:var(--env2-glow);white-space:nowrap;unicode-bidi:isolate}
.env2-price bdi{unicode-bidi:isolate;font-variant-numeric:tabular-nums}
.env2-price__from{font-family:var(--env2-sans);font-weight:400;font-size:.62em;color:var(--env2-ink-2);margin-inline-end:.15em;letter-spacing:0}
.env2-hair{border:0;border-top:1px solid var(--env2-hair);margin:0}

/* ---------- buttons + links (§3.4 #5) ---------- */
.env2-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;white-space:nowrap;margin:0;padding:14px 22px;min-height:0;border:0;border-radius:999px;appearance:none;-webkit-appearance:none;cursor:pointer;font-family:var(--env2-sans);font-weight:500;font-size:15px;line-height:1.2;letter-spacing:0;text-transform:none;text-decoration:none;background:var(--env2-glow);color:var(--env2-btn-ink);box-shadow:none;transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .5s,color .3s,background-color .3s}
.env2-btn:hover,.env2-btn:focus-visible{transform:translateY(-2px);box-shadow:0 10px 40px -8px rgba(255,211,148,.55);background:var(--env2-glow);color:var(--env2-btn-ink);text-decoration:none}
.env2-btn--ghost,.env2-btn--ghost:hover,.env2-btn--ghost:focus-visible{background:transparent;color:var(--env2-ink)}
.env2-btn--ghost{box-shadow:inset 0 0 0 1px var(--env2-hair-btn)}
.env2-btn--ghost:hover,.env2-btn--ghost:focus-visible{box-shadow:inset 0 0 0 1px var(--env2-glow),0 10px 40px -12px rgba(255,211,148,.4)}
.env2-btn--sm{padding:10px 16px;font-size:13.5px}
.env2-btn svg{width:16px;height:16px;flex:none}
.env2-buy{display:inline-block;margin:0;padding:0}
.env2-link{display:inline-flex;align-items:center;gap:8px;font-family:var(--env2-sans);font-size:14px;font-weight:500;line-height:1.3;color:var(--env2-ink-2);border-bottom:1px solid var(--env2-hair-btn);padding-bottom:3px;text-decoration:none;transition:color .3s,border-color .3s}
.env2-link:hover,.env2-link:focus-visible{color:var(--env2-glow);border-color:var(--env2-glow);text-decoration:none}
.env2-link svg{width:14px;height:14px;flex:none}
@media (max-width:900px){.env2-btn{font-size:14px;padding:13px 20px}.env2-btn--sm{font-size:14px;padding:14px 18px;min-height:44px}.env2-link{position:relative}.env2-link::before{content:"";position:absolute;inset:-11px -6px}}

/* ---------- stars (§3.1): static layer, per-section opacity via --env2-stars ---------- */
.env2-stars{position:absolute;inset:0;pointer-events:none;z-index:0;opacity:var(--env2-stars,.25);
  background-image:
   radial-gradient(1px 1px at 12% 18%,#fff 60%,transparent 61%),
   radial-gradient(1.2px 1.2px at 78% 12%,#fff 60%,transparent 61%),
   radial-gradient(1px 1px at 33% 62%,#fff 60%,transparent 61%),
   radial-gradient(1.4px 1.4px at 61% 34%,#fff 60%,transparent 61%),
   radial-gradient(1px 1px at 88% 71%,#fff 60%,transparent 61%),
   radial-gradient(1px 1px at 45% 9%,#fff 60%,transparent 61%),
   radial-gradient(1.2px 1.2px at 23% 87%,#fff 60%,transparent 61%),
   radial-gradient(1px 1px at 69% 84%,#fff 60%,transparent 61%),
   radial-gradient(1px 1px at 5% 48%,#fff 60%,transparent 61%),
   radial-gradient(1.3px 1.3px at 95% 42%,#fff 60%,transparent 61%),
   radial-gradient(1px 1px at 52% 55%,#fff 60%,transparent 61%);
  background-size:900px 700px}

/* ---------- the lamp device (§3.4 #1): dim until reached, then lit, never dark again ----------
   --lit is 1 by default (no JS = lit). Only html.env2-js dims lamps; .lit re-lights them. */
.env2-js [data-lamp]{--lit:0}
.env2-js [data-lamp].lit{--lit:1}
[data-lamp] .env2-ph{position:relative;overflow:hidden;background:#05070c;isolation:isolate}
[data-lamp] .env2-ph img{width:100%;height:100%;object-fit:cover;filter:brightness(calc(.22 + .78*var(--lit,1))) saturate(calc(.4 + .6*var(--lit,1)));transition:filter 1.6s cubic-bezier(.2,.7,.2,1);transform:scale(1.02)}
[data-lamp] .env2-ph::after{content:"";position:absolute;inset:-20%;pointer-events:none;background:radial-gradient(60% 55% at 50% 45%,rgba(255,211,148,.42),rgba(255,211,148,0) 70%);opacity:var(--lit,1);transition:opacity 1.6s .2s;mix-blend-mode:screen}
[data-lamp] .env2-halo{position:absolute;inset:-12%;pointer-events:none;background:radial-gradient(50% 50% at 50% 60%,rgba(255,196,110,.35),transparent 70%);opacity:var(--lit,1);transition:opacity 2s .3s;z-index:-1;filter:blur(14px)}
[data-lamp] .env2-pool{position:absolute;inset:auto -30% -18% -30%;height:60%;pointer-events:none;background:radial-gradient(50% 60% at 50% 40%,rgba(255,196,110,.28),transparent 70%);opacity:var(--lit,1);transition:opacity 1.8s .2s;filter:blur(12px);z-index:-1}
@keyframes env2-lamp-on{0%{opacity:0}40%{opacity:1}55%{opacity:.25}70%{opacity:1}100%{opacity:1}}
@keyframes env2-flick{0%{opacity:1}30%{opacity:.15}60%{opacity:.9}80%{opacity:.3}100%{opacity:1}}

/* ---------- reduced motion (§3.4): lamps lit, no sweeps, no parallax, no transitions ---------- */
@media (prefers-reduced-motion:reduce){
  .env2-js [data-lamp],[data-lamp],.env2-js [data-lamp].lit{--lit:1}
  .env2-section,.env2-section *,.env2-section *::before,.env2-section *::after,.env2-btn,.env2-link{transition:none!important;animation:none!important;scroll-behavior:auto!important}
}
</style>
<script id="env2-base-js">
(function(){
  if (window.env2 && window.env2.observe) return;
  var root = document.documentElement;
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var seen = (typeof WeakSet === 'function') ? new WeakSet() : null;
  var tracked = [];
  var io = null;

  function light(el){ if (el && el.classList) el.classList.add('lit'); }
  function inView(el){
    var vh = window.innerHeight || root.clientHeight; var r = el.getBoundingClientRect();
    return r.top < vh * 0.82 && r.bottom > vh * 0.1;
  }
  /* belt and braces: light anything already inside the viewport (passive scroll, rAF) */
  function sweep(){
    for (var i = tracked.length - 1; i >= 0; i--) {
      var el = tracked[i];
      if (el.classList.contains('lit')) { tracked.splice(i, 1); continue; }
      if (inView(el)) { light(el); if (io) io.unobserve(el); tracked.splice(i, 1); }
    }
  }
  function getIO(){
    if (io || !('IntersectionObserver' in window)) return io;
    io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting) { light(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.25, rootMargin: '0px 0px -6% 0px' });
    return io;
  }
  /* observe(root): idempotent, safe per section, safe on document. Lamps with
     data-lamp="manual" are left to their section (light them with env2.light(el)),
     except under reduced motion, where every lamp is lit at once. */
  function observe(rootEl){
    rootEl = rootEl || document;
    var list = [];
    if (rootEl.nodeType === 1 && rootEl.hasAttribute('data-lamp')) list.push(rootEl);
    var q = rootEl.querySelectorAll ? rootEl.querySelectorAll('[data-lamp]') : [];
    for (var i = 0; i < q.length; i++) list.push(q[i]);
    list.forEach(function(el){
      if (el.classList.contains('lit')) return;
      if (seen ? seen.has(el) : el.__env2seen) return;
      if (el.getAttribute('data-lamp') === 'manual' && !rm) return;
      if (seen) seen.add(el); else el.__env2seen = true;
      if (rm || !getIO()) { light(el); return; }
      tracked.push(el); io.observe(el);
    });
    sweep();
    return list.length;
  }

  /* scroll progress → --env2-p (alias --p) on <html>; the sun rail and the hero use it */
  var ticking = false;
  function onScroll(){
    if (ticking) return; ticking = true;
    requestAnimationFrame(function(){
      var max = Math.max(1, root.scrollHeight - window.innerHeight);
      var y = window.scrollY || window.pageYOffset || 0;
      var p = rm ? 0 : Math.min(1, Math.max(0, y / max));
      var v = p.toFixed(4);
      root.style.setProperty('--env2-p', v); root.style.setProperty('--p', v);
      sweep();
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  window.addEventListener('load', onScroll);

  /* in-page anchors to sections (#env2-…) scroll smoothly, instantly under reduced motion */
  document.addEventListener('click', function(e){
    var a = e.target && e.target.closest ? e.target.closest('a[href^="#env2-"]') : null;
    if (!a) return;
    var t = document.getElementById(a.getAttribute('href').slice(1));
    if (!t) return;
    e.preventDefault();
    t.scrollIntoView({ behavior: rm ? 'auto' : 'smooth', block: 'start' });
    if (window.history && history.replaceState) history.replaceState(null, '', a.getAttribute('href'));
  });

  /* buy forms (snippets/elmsnest-v2-buy): add to cart without leaving the page and open the Kalles
     cart drawer. Anything missing (no drawer, no fetch, request failed) → the native POST still works. */
  document.addEventListener('submit', function(e){
    var form = e.target;
    if (!form || !form.matches || !form.matches('form[data-env2-buy]')) return;
    var drawer = document.querySelector('hdt-cart-drawer[section-id]');
    if (!drawer || typeof window.fetch !== 'function' || typeof window.FormData !== 'function') return;
    e.preventDefault();
    var btn = form.querySelector('[type="submit"]');
    var fd = new FormData(form);
    fd.append('sections', drawer.getAttribute('section-id'));
    fd.append('sections_url', location.pathname);
    if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); }
    var rootPath = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    fetch(rootPath + 'cart/add.js', {
      method: 'POST', body: fd,
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript' }
    }).then(function(r){ return r.json(); }).then(function(j){
      if (!j || j.status) throw new Error('cart/add failed');
      document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: {
        resource: {}, sourceId: String(fd.get('id')), cartData: j,
        actionAfterATC: 'open_cart_drawer', source: 'product-form-component',
        data: { itemCount: 1, sections: j.sections }
      } }));
    }).catch(function(){
      if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
      form.submit();
    }).then(function(){
      if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); }
    });
  });

  window.env2 = { rm: rm, observe: observe, sweep: sweep, light: light, version: '2.0' };

  function boot(){ observe(document); onScroll(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', function(e){ observe(e.target || document); });
})();
</script>
