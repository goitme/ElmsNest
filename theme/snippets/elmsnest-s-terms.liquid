{%- comment -%}
  ElmsNest S — the three consumer numbers (SIMPLIFY SPEC §5.3). Rendered by sections/elmsnest-s-terms
  (home only): {% render 'elmsnest-s-terms' %}. No inputs.

  Row copy is BYTE-FOR-BYTE the dev-theme templates/collection.json -> sections.coll_terms.blocks
  term_ship / term_days / term_cancel (numeral, unit, headline, sub). The "1 תמונה" row is dropped:
  the contact line (§5.4) is the only photo promise on a page. Legal wording — never shortened.
  Foot line: the four policy links, labels verbatim from sections/elmsnest-v2-coll-terms.liquid
  line 335, first link kept on /pages/shipping-delivery so the strip and the footer agree.

  Bidi (P6): the numeral sits in its own <bdi dir="ltr">; in the text lines every token that
  carries digits gets its digit run (with any en-dash range) wrapped in <bdi dir="ltr"> at render
  time — "1–3" and "ו־7–14" never flip, and the merchant copy stays plain text.
{%- endcomment -%}
{%- liquid
  assign ens_n1 = '0'
  assign ens_u1 = '₪'
  assign ens_h1 = 'משלוח לנקודת איסוף — חינם.'
  assign ens_s1 = 'עד הבית 29.90 ₪.'
  assign ens_n2 = '8–17'
  assign ens_u2 = 'ימי עסקים'
  assign ens_h2 = 'לאספקה: 1–3 ימי טיפול ו־7–14 ימי משלוח.'
  assign ens_s2 = 'ייתכן משלוח ממחסן מחוץ לישראל.'
  assign ens_n3 = '14'
  assign ens_u3 = 'יום'
  assign ens_h3 = 'לביטול מקבלת המוצר, לפי חוק הגנת הצרכן.'
  assign ens_s3 = 'דמי ביטול עד 5% או 100 ₪ — הנמוך מביניהם.'

  assign ens_nums = ens_n1 | append: '|' | append: ens_n2 | append: '|' | append: ens_n3 | split: '|'
  assign ens_units = ens_u1 | append: '|' | append: ens_u2 | append: '|' | append: ens_u3 | split: '|'
  assign ens_heads = ens_h1 | append: '|' | append: ens_h2 | append: '|' | append: ens_h3 | split: '|'
  assign ens_subs = ens_s1 | append: '|' | append: ens_s2 | append: '|' | append: ens_s3 | split: '|'
  assign ens_digits = '0123456789'
-%}
<style>
.ens-terms__rows{list-style:none;margin:0;padding:0}
.ens-terms__row{display:grid;grid-template-columns:minmax(150px,.26fr) minmax(0,1fr);gap:6px 28px;align-items:baseline;margin:0;padding:16px 0;border-top:1px solid var(--env2-hair)}
.ens-terms__row:last-child{border-bottom:1px solid var(--env2-hair)}
.ens-terms__n{display:block;min-width:0;font-family:var(--env2-serif);font-weight:700;font-size:26px;line-height:1.1;letter-spacing:-.01em;color:var(--env2-gold);font-variant-numeric:tabular-nums;white-space:nowrap}
.ens-terms__num{unicode-bidi:isolate}
.ens-terms__unit{display:inline;font-family:var(--env2-sans);font-weight:400;font-size:13px;line-height:1;letter-spacing:0;color:var(--env2-ink-2);margin-inline-start:6px}
.ens-terms__t{display:block;min-width:0;max-width:56ch}
.ens-terms__b{display:block;font-family:var(--env2-sans);font-weight:500;font-size:16px;line-height:1.35;color:var(--env2-ink)}
.ens-terms__p{display:block;margin:3px 0 0;font-family:var(--env2-sans);font-weight:300;font-size:13px;line-height:1.5;color:var(--env2-ink-2)}
.ens-terms__t bdi{unicode-bidi:isolate}
.ens-terms__foot{margin:16px 0 0;font-family:var(--env2-sans);font-weight:400;font-size:13px;line-height:1.4;color:var(--env2-mute)}
/* 44 px tap height, hairline underline; the negative margin keeps the foot one text line tall */
.ens-terms__foot a{display:inline-block;padding-block:13px;margin-block:-13px;color:inherit;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.25em;text-decoration-color:rgba(143,149,163,.45);transition:color .3s,text-decoration-color .3s}
.ens-terms__foot a:hover,.ens-terms__foot a:focus-visible{color:var(--env2-glow);text-decoration-color:var(--env2-glow)}
.ens-terms__foot a:focus-visible{outline:2px solid var(--env2-glow);outline-offset:2px}
@media (max-width:900px){
  .ens-terms__row{grid-template-columns:72px minmax(0,1fr);gap:12px;padding:12px 0}
  .ens-terms__n{white-space:normal}
  .ens-terms__unit{display:block;margin:4px 0 0}
}
@media (prefers-reduced-motion:reduce){
  .ens-terms__foot a{transition:none}
}
</style>
<ul class="ens-terms__rows">
{%- for ens_i in (0..2) -%}
  {%- liquid
    # wrap the digit run of every token in <bdi dir="ltr">: whole token when it starts with a digit,
    # the tail after a Hebrew prefix otherwise (ו־7–14 -> ו־<bdi dir="ltr">7–14</bdi>)
    assign ens_bline = ''
    assign ens_pline = ''
    for ens_part in (1..2)
      if ens_part == 1
        assign ens_src = ens_heads[ens_i]
      else
        assign ens_src = ens_subs[ens_i]
      endif
      assign ens_line = ''
      assign ens_words = ens_src | escape | split: ' '
      for ens_w in ens_words
        assign ens_pre = ens_w.size
        for ens_s in (1..12)
          assign ens_i0 = ens_s | minus: 1
          assign ens_ch = ens_w | slice: ens_i0, 1
          if ens_ch != '' and ens_digits contains ens_ch
            assign ens_pre = ens_i0
            break
          endif
        endfor
        if ens_pre < ens_w.size
          assign ens_head = ens_w | slice: 0, ens_pre
          assign ens_tail = ens_w | slice: ens_pre, ens_w.size
          assign ens_tok = ens_head | append: '<bdi dir="ltr">' | append: ens_tail | append: '</bdi>'
        else
          assign ens_tok = ens_w
        endif
        if forloop.first
          assign ens_line = ens_tok
        else
          assign ens_line = ens_line | append: ' ' | append: ens_tok
        endif
      endfor
      assign ens_line = ens_line | replace: '</bdi> ₪', '</bdi>&nbsp;₪'
      if ens_part == 1
        assign ens_bline = ens_line
      else
        assign ens_pline = ens_line
      endif
    endfor
  -%}
  <li class="ens-terms__row">
    <span class="ens-terms__n"><bdi dir="ltr" class="ens-terms__num">{{ ens_nums[ens_i] }}</bdi><small class="ens-terms__unit">{{ ens_units[ens_i] }}</small></span>
    <span class="ens-terms__t"><b class="ens-terms__b">{{ ens_bline }}</b><span class="ens-terms__p">{{ ens_pline }}</span></span>
  </li>
{%- endfor -%}
</ul>
<nav class="ens-terms__foot" aria-label="עמודי מדיניות"><a href="/pages/shipping-delivery">משלוחים ואספקה</a> · <a href="/pages/processing-time">זמני טיפול</a> · <a href="/policies/refund-policy">מדיניות ביטולים</a> · <a href="/pages/help-faq">שאלות נפוצות</a></nav>
