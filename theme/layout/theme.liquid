<!doctype html>
{%- liquid
  assign iso_code  = request.locale.iso_code
  assign config_rtl  = settings.right_to_left | default: 'enable-with-list'
  assign is_rtl = false
  assign dir = 'ltr'
  if config_rtl == 'enable-with-list'
    assign iso_code_ck = iso_code | split: '-' | first | append: ';' | prepend: ';'
    assign lis_rtl = ';ae;ar;arc;bqi;ckb;dv;fa;glk;ha;he;kwh;ks;ku;mzn;nqo;pnb;ps;sd;ug;ur;yi;'
    if lis_rtl contains iso_code_ck
      assign is_rtl = true
      assign dir = 'rtl'
    endif
  elsif config_rtl == 'enable'
    assign is_rtl = true
    assign dir = 'rtl'
  endif
-%}

<html class="no-js hdt-pr-img__effect-{{ settings.effect_secondary_image }} hdt-badge__shape-{{ settings.badge_shape }} dir--{{ dir }}{% if request.design_mode %} shopify-design-mode{% endif %} {% if settings.minimal_products %} hdt-minimal-products{% endif %}{% if settings.hidden_badges %} hdt-hidden-pr-badges{% endif %}{% if settings.hidden_quickview %} hdt-hidden-pr-quickview{% endif %}{% if settings.hidden_wishlist %} hdt-hidden-pr-wishlist{% endif %}{% if settings.hidden_compare %} hdt-hidden-pr-compare{% endif %}{% if settings.uppercase_title %} hdt-pr-uppercase_title{% endif %} {% if settings.layout_boxed %} hdt-layout-boxed{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    {%- comment -%}
      elmsnest-measurement-preview معطّل عن قصد على الثيم المنشور — 2026-08-24.

      الـsnippet بيحقن حاوية GTM-NCK2MKW2 يدوياً، وتطبيق Google & YouTube
      بيحقن نفس الحاوية. النتيجة كانت حاوية بتتحمّل مرتين، ومعها
      AW-17540075563 وGT-PBSXTWDK مرتين لكل زيارة — يعني **كل تحويل
      بينحسب مرتين** بـGoogle Ads، والمزايدة الذكية بتبني على ROAS مضاعف.

      تعليق الـsnippet نفسه بيقول إنه للثيم غير المنشور بس؛ وصل للحي
      بالغلط. المصدر الوحيد المفروض يضل التطبيق، لأنه بيتعامل مع طبقة
      موافقة Shopify وأحداث الـcheckout صح — وهي أشياء الحقن اليدوي
      ما بيوصلها.

      الملف انترك مكانه عشان يضل صالح للاستخدام على ثيم تطوير.
      ما ترجّع هالسطر للمنشور إلا لو التطبيق انشال.
    {%- endcomment -%}
 {%- capture ecom_header_content -%}{%- render 'ecom_header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#020306">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if request.page_type == 'search' or request.page_type == 'cart' -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}

    {%- if settings.library_font == "shopify" -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}
    {%- if settings.library_font == 'google' -%}
      {%- assign google_font_async = settings.embed_google_font | replace: 'rel="stylesheet"', 'rel="stylesheet" media="print" onload="this.media=&quot;all&quot;"' -%}
      {{- google_font_async -}}
      <noscript>{{ settings.embed_google_font }}</noscript>
    {%- endif -%}
    {%- if request.page_type == 'index' -%}
      {%- comment -%}
        ElmsNest v2 (2026-09-01): preload the hero photo the elmsnest-v2-hero section renders.
        Keep the handle + index in sync with templates/index.json -> env2_hero.settings
        (product / bg_image_index / bg_image_index_mobile). If the merchant sets the
        bg_image / bg_image_mobile picker overrides, delete this block - a mismatched preload
        is a double download, a missing one is harmless. Breakpoint 900px = the hero's <picture>.
      {%- endcomment -%}
      {%- liquid
        assign en_hero_pr = all_products['stainless-steel-solar-path-light-ip65']
        assign en_hero_desk = en_hero_pr.images[0] | default: en_hero_pr.featured_image
        assign en_hero_mob = en_hero_pr.images[0] | default: en_hero_pr.featured_image
      -%}
      {%- if en_hero_mob != blank -%}
        {%- comment -%} R26: cap 1000/1400 against the image width exactly like the hero's mobile <source srcset> (else 1000w) {%- endcomment -%}
        {%- assign en_hero_m_widths = '1000,1400' | split: ',' -%}
        {%- assign en_hero_m_sep = '' -%}
        {%- capture en_hero_m_srcset -%}
          {%- for en_w in en_hero_m_widths -%}
            {%- assign en_wn = en_w | plus: 0 -%}
            {%- if en_wn <= en_hero_mob.width -%}
              {{- en_hero_m_sep -}}{{ en_hero_mob | image_url: width: en_wn }} {{ en_wn }}w
              {%- assign en_hero_m_sep = ', ' -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if en_hero_m_srcset == blank -%}
          {%- capture en_hero_m_srcset -%}{{ en_hero_mob | image_url: width: 1000 }} 1000w{%- endcapture -%}
        {%- endif -%}
        <link rel="preload" as="image" media="(max-width: 900px)" fetchpriority="high"
          href="{{ en_hero_mob | image_url: width: 1000 }}"
          imagesrcset="{{ en_hero_m_srcset | strip }}"
          imagesizes="100vw">
      {%- endif -%}
      {%- if en_hero_desk != blank -%}
        {%- assign en_hero_widths = '900,1400,1800,2400' | split: ',' -%}
        {%- assign en_hero_sep = '' -%}
        {%- capture en_hero_srcset -%}
          {%- for en_w in en_hero_widths -%}
            {%- assign en_wn = en_w | plus: 0 -%}
            {%- if en_wn <= en_hero_desk.width -%}
              {{- en_hero_sep -}}{{ en_hero_desk | image_url: width: en_wn }} {{ en_wn }}w
              {%- assign en_hero_sep = ', ' -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        <link rel="preload" as="image" media="(min-width: 901px)" fetchpriority="high"
          href="{{ en_hero_desk | image_url: width: 1800 }}"
          imagesrcset="{{ en_hero_srcset | strip }}"
          imagesizes="100vw">
      {%- endif -%}
    {%- elsif request.page_type == 'product' -%}
      {%- comment -%}
        K4 (PF6): preload the first product image only when the gallery provably
        starts on it — mirrors the startIndex logic of blocks/_product-medias.liquid
        (pick_mode first_available => selected_or_first_available_variant.featured_media).
        imagesrcset/imagesizes replicate exactly what snippets/media.liquid's image_tag
        emits for the eager first image (same widths list capped at image width, same
        sizes string added in K2). If any condition fails we skip the preload —
        a missing preload is harmless, a mismatched one is a double download.
      {%- endcomment -%}
      {%- liquid
        assign en_preload_ok = false
        assign en_first_media = product.media.first
        if product.media.size > 1 and en_first_media.media_type == 'image' and product.metafields.theme.group_media_obj.value == blank
          assign en_start_media = product.selected_or_first_available_variant.featured_media | default: en_first_media
          if en_start_media.id == en_first_media.id
            assign en_preload_ok = true
          endif
        endif
      -%}
      {%- if en_preload_ok -%}
        {%- assign en_preload_img = en_first_media.preview_image -%}
        {%- assign en_preload_widths = '246,493,600,713,823,990,1100,1206,1346,1426,1646,1946' | split: ',' -%}
        {%- assign en_preload_sep = '' -%}
        {%- capture en_preload_srcset -%}
          {%- for en_w in en_preload_widths -%}
            {%- assign en_wn = en_w | plus: 0 -%}
            {%- if en_wn <= en_preload_img.width -%}
              {{- en_preload_sep -}}{{ en_preload_img | image_url: width: en_wn }} {{ en_wn }}w
              {%- assign en_preload_sep = ', ' -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        <link rel="preload" as="image" href="{{ en_preload_img | image_url: width: en_preload_img.width }}" imagesrcset="{{ en_preload_srcset }}" imagesizes="(min-width: 768px) 50vw, 100vw" fetchpriority="high">
      {%- endif -%}
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tag' | t }} "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- liquid
      render 'social-meta-tags'
      render 'css-variables', is_rtl: is_rtl
      unless request.page_type == 'index'
        render 'product-styles'
      endunless
      render 'js-variables'
      render 'scripts'
      if settings.custom_html_head != blank
        echo settings.custom_html_head
      endif
    -%}

    {{ content_for_header }}
    {%- endunless -%}
  </head>

  <body class="hdt-page-type-{{ request.page_type }}">
    {%- comment -%} نصف الـnoscript من نفس الـsnippet المعطّل — شوف الشرح بالـhead {%- endcomment -%}
    {% comment %} {%- section 'product-card-configs' -%} {% endcomment %}
    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    {%- render 's-dom-temp' -%}
    <a class="skip-to-content-link button sr-only " href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {%- sections 'header-group' -%}
    {%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
      {%- if template.suffix == 'only_config' -%}
        {%- section 'color-swatch' -%}
      {%- endif -%}
    </main>

    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    <footer>
      {%- sections 'footer-group' -%}
    </footer>
    {%- liquid
      sections 'system-group'
      if settings.enable_compare_popup
        render 'compare-offcanvas'
      endif
      render 'system-bottom'
      if settings.custom_html_footer != blank
        echo settings.custom_html_footer
      endif
      render 'structured-data'
    -%}
   {%- endunless -%}
  {%- render 'elmsnest-whatsapp' -%}
  {%- capture ecom_footer_content -%}{%- render 'ecom_footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}</body>
</html>
