{%- comment -%}
  ElmsNest «איפה צריך אור?» — rebuilt condensed, 2026-09-01.

  The old sections/elmsnest-home-places.liquid was the best idea on the page
  and the heaviest object on it: a four-row ruled table where every row spent
  two full sentences on «what the light should do» and two more on «when it
  does not suit». That is the store's one real differentiator — the five
  competitors all sell the same catalogue and none of them tell you when to
  not buy — so it stays. What goes is the word count.

  One clause per field. The negative keeps equal visual weight to the job,
  because the moment it is set smaller it becomes a caveat instead of a
  specification, and the differentiator is gone. Anyone who wants the full
  reasoning follows the guide link, which is where the long form always lived.

  Sourcing rule from the old section still holds and is not negotiable: every
  «not for» line must be a compression of something already published on
  /pages/guide-garden-lighting or /pages/why-solar-lighting. «מי אנחנו»
  commits to not stating unverified information as fact, and a negative
  invented for a homepage tile is exactly the kind of claim that is easiest
  to be wrong about. Shorten the published line — never write a new one.
{%- endcomment -%}

<section id="elmsnest-places" class="en-pl" dir="rtl" aria-labelledby="en-pl-title-{{ section.id }}">
  <div class="en-pl__wrap">

    <header class="en-pl__head">
      <div>
        <h2 class="en-pl__title" id="en-pl-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="en-pl__lede">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.guide_label != blank -%}
        <a class="en-pl__guide" href="{{ section.settings.guide_url | default: pages['guide-garden-lighting'].url }}">
          {{ section.settings.guide_label }} <span aria-hidden="true">←</span>
        </a>
      {%- endif -%}
    </header>

    <ul class="en-pl__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign place = block.settings.collection -%}
        {%- if place != blank and place.products_count > 0 -%}
          <li class="en-pl__item" {{ block.shopify_attributes }}>
            <a href="{{ place.url }}">
              <span class="en-pl__name">{{ block.settings.place_label | default: place.title }}</span>

              <span class="en-pl__field en-pl__field--yes">
                <span class="en-pl__key">{{ section.settings.job_label }}</span>
                <span class="en-pl__val">{{ block.settings.job }}</span>
              </span>

              <span class="en-pl__field en-pl__field--no">
                <span class="en-pl__key">{{ section.settings.not_label }}</span>
                <span class="en-pl__val">{{ block.settings.not_for }}</span>
              </span>

              <span class="en-pl__foot">
                <bdi dir="ltr">{{ place.products_count }}</bdi> {{ section.settings.count_word }}
                <span class="en-pl__go" aria-hidden="true">←</span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
.en-pl,.en-pl *{box-sizing:border-box}
.en-pl{
  --night:var(--en-night,43 33 24);
  --paper:var(--en-paper,255 253 247);
  --gold:var(--en-gold,217 173 95);
  direction:rtl;padding:clamp(52px,6.4vw,84px) 0;
  background:rgb(var(--paper));color:rgb(var(--night));
  scroll-margin-top:90px
}
.en-pl__wrap{width:min(1200px,100%);margin-inline:auto;padding-inline:clamp(18px,4vw,40px)}

.en-pl__head{
  display:flex;align-items:flex-end;justify-content:space-between;gap:20px;
  margin-bottom:clamp(24px,3.2vw,34px)
}
.en-pl__title{
  margin:0;color:rgb(var(--night))!important;
  font-size:clamp(28px,4.2vw,46px);line-height:1.1;letter-spacing:normal;text-wrap:balance
}
.en-pl__lede{margin:11px 0 0;color:rgb(var(--night)/.70);font-size:clamp(15px,1.7vw,17px);line-height:1.5;max-width:36rem}
.en-pl__guide{
  flex-shrink:0;color:rgb(var(--night))!important;font-weight:600;font-size:15px;
  text-decoration:none;border-block-end:1px solid rgb(var(--night)/.35);padding-block-end:3px
}
.en-pl__guide:hover{border-color:rgb(var(--night))}

.en-pl__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin:0;padding:0;list-style:none;
  border:1px solid rgb(var(--night)/.16)}
.en-pl__item{min-width:0;border-inline-start:1px solid rgb(var(--night)/.16)}
.en-pl__item:first-child{border-inline-start:0}
.en-pl__item > a{
  display:flex;flex-direction:column;gap:13px;height:100%;
  padding:clamp(18px,2vw,24px);
  color:rgb(var(--night))!important;text-decoration:none;
  transition:background-color .18s ease
}
.en-pl__item > a:hover{background:rgb(var(--night)/.045)}
.en-pl__item > a:focus-visible{outline:3px solid rgb(var(--night));outline-offset:-3px}

.en-pl__name{font-size:clamp(17px,1.9vw,20px);font-weight:700;line-height:1.25;text-wrap:balance}

.en-pl__field{display:flex;flex-direction:column;gap:4px}
.en-pl__key{
  display:flex;align-items:center;gap:6px;
  color:rgb(var(--night)/.55);font-size:11px;font-weight:700;letter-spacing:.05em;line-height:1.2
}
/* The two fields are told apart by a marker, not by size or colour. Equal
   type size is the whole point: the negative is a specification, not a
   warning and not a footnote. */
.en-pl__key::before{content:"";width:7px;height:7px;flex:0 0 7px}
.en-pl__field--yes .en-pl__key::before{background:rgb(var(--gold))}
.en-pl__field--no .en-pl__key::before{background:rgb(var(--night)/.35)}
.en-pl__val{color:rgb(var(--night)/.82);font-size:14px;line-height:1.45}

.en-pl__foot{
  display:flex;align-items:center;gap:8px;margin-block-start:auto;padding-block-start:10px;
  border-block-start:1px solid rgb(var(--night)/.14);
  color:rgb(var(--night)/.52);font-size:12px;font-variant-numeric:tabular-nums
}
.en-pl__go{margin-inline-start:auto;color:rgb(var(--night)/.75);font-size:15px;transition:transform .18s ease}
.en-pl__item > a:hover .en-pl__go{transform:translateX(-3px)}

@media(max-width:1099px){
  .en-pl__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .en-pl__item:nth-child(odd){border-inline-start:0}
  .en-pl__item:nth-child(n+3){border-block-start:1px solid rgb(var(--night)/.16)}
}
@media(max-width:749px){
  .en-pl__wrap{padding-inline:16px}
  .en-pl__head{flex-direction:column;align-items:flex-start;gap:12px}
  .en-pl__grid{grid-template-columns:1fr}
  .en-pl__item{border-inline-start:0}
  .en-pl__item + .en-pl__item{border-block-start:1px solid rgb(var(--night)/.16)}
}
@media(prefers-reduced-motion:reduce){.en-pl__item > a,.en-pl__go{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "ElmsNest places",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "איפה צריך אור?" },
    { "type": "text", "id": "intro", "label": "משפט תומך", "default": "לכל מקום — מה שמתאים, ומה שלא." },
    { "type": "text", "id": "job_label", "label": "תווית: תפקיד האור", "default": "מתאים ל" },
    { "type": "text", "id": "not_label", "label": "תווית: לא מתאים", "default": "לא מתאים כאשר" },
    { "type": "text", "id": "count_word", "label": "מילת הספירה", "default": "מוצרים" },
    { "type": "text", "id": "guide_label", "label": "קישור למדריך", "default": "למדריך המלא" },
    { "type": "url", "id": "guide_url", "label": "כתובת המדריך", "info": "ברירת מחדל: מדריך לבחירת תאורה לגינה" }
  ],
  "blocks": [
    {
      "type": "place",
      "name": "מקום",
      "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "קולקציה" },
        { "type": "text", "id": "place_label", "label": "שם המקום", "info": "איפה הקונה עומד — לא בהכרח שם הקולקציה" },
        { "type": "text", "id": "job", "label": "מתאים ל", "info": "פסוקית אחת קצרה" },
        { "type": "text", "id": "not_for", "label": "לא מתאים כאשר", "info": "חובה לקצר שורה שכבר מפורסמת ב«איך בוחרים תאורה» או ב«למה תאורה סולארית». אין לנסח טענה חדשה." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ElmsNest places",
      "blocks": [{ "type": "place" }, { "type": "place" }, { "type": "place" }, { "type": "place" }]
    }
  ]
}
{% endschema %}
