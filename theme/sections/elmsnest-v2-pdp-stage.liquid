    { "type": "text", "id": "object_position_mobile", "label": "מיקוד התמונה — מובייל", "default": "50% 50%" },
    { "type": "header", "content": "מה נדלק על התמונה" },
    { "type": "select", "id": "stage_device", "label": "התאורה שמצוירת על התמונה", "options": [ { "value": "string", "label": "שרשרת נורות" }, { "value": "path", "label": "שורת מנורות בשביל" }, { "value": "halo", "label": "הילה על הקיר" }, { "value": "none", "label": "בלי ציור" } ], "default": "string" },
    { "type": "text", "id": "device_x", "label": "מיקום ההילה — רוחב", "default": "50%" },
