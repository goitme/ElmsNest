    { "type": "text", "id": "rail_label", "label": "כותרת המסילה (ריק = שם האפשרות)" },
    { "type": "text", "id": "rail_note", "label": "הערה בקצה כותרת המסילה" },
    { "type": "text", "id": "quantity_steps", "label": "כמויות במסילה (מוצר עם וריאנט אחד)", "default": "1,2,3,4,6,8" },
    { "type": "text", "id": "quantity_unit_one", "label": "יחידת כמות — יחיד", "default": "יחידה" },
    { "type": "text", "id": "quantity_unit", "label": "יחידת כמות — רבים", "default": "יחידות" },
