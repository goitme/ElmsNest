    { "type": "text", "id": "quiet_axis_note", "label": "הערה מתחת לבורר (ריק = נוסחת ברירת מחדל לפי שם האפשרות)" },
    { "type": "textarea", "id": "range_note", "label": "שורת הטווח (ריק = מחושבת מהמחירים של המוצר)" },
