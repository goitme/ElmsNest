    { "type": "textarea", "id": "terms_strip", "label": "שורת התנאים שמתחת לכפתור", "default": "משלוח לנקודת איסוף חינם · אספקה <bdi>8–17</bdi> ימי עסקים · ביטול עד <bdi>14</bdi> יום מקבלת המוצר." },
    { "type": "text", "id": "terms_link_label", "label": "קישור לכל המספרים", "default": "כל המספרים" },
    { "type": "text", "id": "photo_intro", "label": "הצעד הקטן — פתיח", "default": "לפני שמזמינים אפשר" },
    { "type": "text", "id": "photo_cta_label", "label": "הצעד הקטן — טקסט הקישור (ריק = ברירת המחדל של החנות)" },
    { "type": "text", "id": "mailto_subject", "label": "נושא המייל לבדיקת התאמה" },
    { "type": "header", "content": "הסרגל הדביק במובייל" },
    { "type": "checkbox", "id": "show_buybar", "label": "להציג סרגל קנייה דביק במובייל", "default": true },
    { "type": "range", "id": "thumb_image_index", "label": "תמונה בסרגל — מספר תמונה במוצר (0 = ברירת מחדל)", "min": 0, "max": 6, "step": 1, "default": 0 }
  ],
  "blocks": [
