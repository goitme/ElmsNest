        var b = sv('g', { 'class': 'env2-pdp-stage__bulb', transform: 'translate(' + x.toFixed(1) + ' ' + y.toFixed(1) + ')' });
        b.appendChild(sv('ellipse', { 'class': 'env2-pdp-stage__halo', cx: 0, cy: 0, rx: (hh * 0.8).toFixed(1), ry: (hh * 0.17).toFixed(1), fill: 'url(#' + uid + '-pool)' }));
        b.appendChild(sv('rect', { 'class': 'env2-pdp-stage__post', x: -w / 2, y: -hh * 0.72, width: w, height: hh * 0.72 }));
        b.appendChild(sv('circle', { 'class': 'env2-pdp-stage__halo', cx: 0, cy: -hh * 0.85, r: (hh * 0.45).toFixed(1), fill: 'url(#' + uid + '-glow)' }));
        b.appendChild(sv('rect', { 'class': 'env2-pdp-stage__core', x: -w / 2, y: -hh, width: w, height: hh * 0.3, fill: '#fff1d6' }));
        gb.appendChild(b); items[i] = b;
      }
      apply(false, 0);
    }
    function apply(anim, from) {
      items.forEach(function (b, i) {
        var on = i < n, dl = (anim && !rm && on && i >= from) ? (i - from) * 60 : 0;
        b.style.setProperty('--dl', dl + 'ms');
        if (on) b.classList.add('env2-pdp-stage__bulb--on'); else b.classList.remove('env2-pdp-stage__bulb--on');
      });
    }
    var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(layout, 160); });
    layout();
    return { set: function (c, anim) { var f = n; n = Math.max(0, Math.min(max, c || 0)); apply(anim !== false, f < n ? f : 0); }, tint: function () {} };
  }

  function makeGlow(node) {
    return {
      set: function (watts) {
        var s = Math.max(0.6, Math.min(1.5, 0.62 + (watts || 6) / 22));
        node.style.setProperty('--env2-pdp-gs', s.toFixed(3));
      },
      tint: function (cool) {
        node.style.setProperty('--env2-pdp-gc', cool ? 'rgba(207,224,255,.6)' : 'rgba(255,211,148,.62)');
      }
    };
  }

  function init(el) {
    var tag = document.getElementById('env2-pdp-variants'), model = null;
    try { if (tag) model = JSON.parse(tag.textContent); } catch (e) { model = null; }

    var priceEl = el.querySelector('[data-env2-stage-price]');
    var mirrorEl = el.querySelector('[data-env2-stage-mirror]');
    var qtyEl = el.querySelector('[data-env2-stage-qty]');
    var idEl = el.querySelector('[data-env2-stage-id]');
    var selectEl = el.querySelector('select[data-env2-stage-quiet]');
    var radios = [].slice.call(el.querySelectorAll('input[type="radio"][data-env2-stage-quiet]'));
    var stops = [].slice.call(el.querySelectorAll('[data-env2-stage-stop]'));
    var track = el.querySelector('[data-env2-stage-track]');
    var fill = el.querySelector('[data-env2-stage-fill]');
    var buyline = el.querySelector('[data-env2-pdp-buyline]');
    var deviceSvg = el.querySelector('[data-env2-stage-device]');
    var glowNode = el.querySelector('[data-env2-stage-glow]');
    var bar = document.querySelector('[data-env2-pdp-bar]');
    var barId = bar && bar.querySelector('[data-env2-bar-id]');
    var barQty = bar && bar.querySelector('[data-env2-bar-qty]');
    var barPrice = bar && bar.querySelector('[data-env2-bar-price]');
    var barMirror = bar && bar.querySelector('[data-env2-bar-mirror]');
    var barImg = bar && bar.querySelector('[data-env2-bar-img]');

    var device = null;
    if (glowNode) device = makeGlow(glowNode);
    else if (deviceSvg) device = deviceSvg.getAttribute('data-kind') === 'path' ? makePath(deviceSvg) : makeString(deviceSvg);

    var single = !model || model.mode === 'single';
    var row = model ? (model.defaultRow || 0) : 0;
    var qty = 1;

    function currentRow() { return model && model.rows ? model.rows[row] : null; }
    /* Shopify names a product's only option "Title"/"Default Title"; that placeholder is never copy. */
    function clean(v) { return (!v || v === 'Default Title') ? '' : v; }
    function quietLabel() {
      if (selectEl && selectEl.selectedIndex > -1) return selectEl.options[selectEl.selectedIndex].text;
      for (var i = 0; i < radios.length; i++) { if (radios[i].checked) return radios[i].parentNode.textContent.trim(); }
      var r = currentRow();
      return (r && r.variants && r.variants.length === 1) ? r.variants[0].label : '';
    }
    function currentId() {
      if (selectEl) return selectEl.value;
      for (var i = 0; i < radios.length; i++) { if (radios[i].checked) return radios[i].value; }
      if (idEl) return idEl.value;
      var r = currentRow();
      return r ? String(r.id) : '';
    }
    function currentCents() {
      var r = currentRow();
      var base = r ? r.price : 0;
      if (!base && priceEl) base = Math.round(parseFloat(priceEl.textContent.replace(/,/g, '')) * 100);
      return base * (single ? qty : 1);
    }

    function paintDevice(anim) {
      if (!device) return;
      var r = currentRow();
      if (glowNode) {
        var w = r && r.n1 ? parseFloat(r.n1) : 6;
        device.set(w);
        device.tint(!!(r && ((r.b || '') + (r.key || '')).indexOf('6000') > -1));
        return;
      }
      if (deviceSvg.getAttribute('data-kind') === 'path') { device.set(single ? qty : (r && r.n1 ? parseFloat(r.n1) : 1), anim); return; }
      var count = 20;
      if (r) count = parseFloat(r.n2 || r.n1 || 20) || 20;
      device.tint(tintOf(quietLabel()));
      device.set(count, anim);
    }

    /* the fill runs from the track's START edge to the chosen stop. Inside an RTL scroll container
       Chrome gives overflowing children a NEGATIVE offsetLeft, so the content edges are measured from
       the stops themselves — scrollWidth/scrollLeft are not usable here. */
    function paintFill() {
      if (!fill || !track) return;
      var on = el.querySelector('.env2-pdp-stage__stop--on');
      if (!on || !stops.length) { fill.style.setProperty('--env2-pdp-fill', '0px'); return; }
      var lo = Infinity, hi = -Infinity;
      stops.forEach(function (s) { lo = Math.min(lo, s.offsetLeft); hi = Math.max(hi, s.offsetLeft + s.offsetWidth); });
      var rtl = (window.getComputedStyle(track).direction === 'rtl');
      var mid = on.offsetLeft + on.offsetWidth / 2;
      var w = rtl ? (hi - mid) : (mid - lo);
      fill.style.setProperty('--env2-pdp-fill', Math.max(0, Math.round(w)) + 'px');
    }

    function paintBar(mirrorText, cents) {
      if (!bar) return;
      if (barId) barId.value = currentId();
      if (barQty) barQty.value = String(single ? qty : 1);
      if (barPrice) barPrice.innerHTML = '<bdi>' + money(cents / 100) + '</bdi> ₪';
      if (barMirror) barMirror.textContent = mirrorText;
      var r = currentRow();
      if (barImg && r && r.image) barImg.setAttribute('src', r.image);
    }

    function syncUrl() {
      if (!window.history || !history.replaceState) return;
      var id = currentId();
      if (!id) return;
      try {
        var u = new URL(window.location.href);
        u.searchParams.set('variant', id);
        history.replaceState(null, '', u.pathname + u.search + u.hash);
      } catch (e) { /* older browser: leave the URL alone */ }
    }

    function apply(anim) {
      var r = currentRow(), cents = currentCents();
      var mirror = '';
      if (single) {
        var one = (mirrorEl && mirrorEl.getAttribute('data-one')) || '';
        var many = (mirrorEl && mirrorEl.getAttribute('data-many')) || '';
        var rowLabel = (mirrorEl && mirrorEl.getAttribute('data-row')) || '';
        mirror = (qty === 1 && one) ? one : (qty + (many ? ' ' + many : ''));
        if (rowLabel && rowLabel !== mirror) mirror += ' · ' + rowLabel;
      } else {
        mirror = r ? clean(r.label) : '';
        var q = clean(quietLabel());
        if (q) mirror = mirror ? (mirror + ' · ' + q) : q;
      }
      if (idEl) idEl.value = currentId();
      if (qtyEl) qtyEl.value = String(single ? qty : 1);
      if (priceEl) countTo(priceEl, cents / 100);
      if (mirrorEl) mirrorEl.textContent = mirror;
      paintBar(mirror, cents);
      paintFill();
      paintDevice(anim !== false);
      syncUrl();
    }

    function pickStop(i, stop) {
      stops.forEach(function (s) { s.classList.remove('env2-pdp-stage__stop--on'); s.removeAttribute('aria-current'); });
      stop.classList.add('env2-pdp-stage__stop--on');
      stop.setAttribute('aria-current', 'true');
      if (single) { qty = parseInt(stop.getAttribute('data-qty'), 10) || 1; }
      else {
        row = i;
        var r = currentRow();
        if (r && r.variants && r.variants.length) {
          if (selectEl) {
            var keep = selectEl.selectedIndex > -1 ? selectEl.options[selectEl.selectedIndex].text : '';
            selectEl.innerHTML = '';
            r.variants.forEach(function (v) {
              var o = document.createElement('option');
              o.value = v.id; o.textContent = v.label; o.disabled = !v.available;
              if (v.label === keep) o.selected = true;
              selectEl.appendChild(o);
            });
          } else if (radios.length) {
            radios.forEach(function (input, k) { if (r.variants[k]) { input.value = r.variants[k].id; input.disabled = !r.variants[k].available; } });
          }
        }
      }
      apply(true);
    }

    stops.forEach(function (stop, i) {
      if (!model) return;
      stop.addEventListener('click', function (ev) {
        ev.preventDefault(); ev.stopPropagation();
        pickStop(parseInt(stop.getAttribute('data-i'), 10) || i, stop);
      });
    });
    if (selectEl) selectEl.addEventListener('change', function () { apply(true); });
    radios.forEach(function (input) { input.addEventListener('change', function () { apply(true); }); });

    /* the sticky bar: shown once the stage's buy line is above the viewport, hidden again while the
       ledger is on screen so there is never a second add-to-cart competing with the row forms. */
    if (bar && buyline) {
      var ledger = document.getElementById('env2-pdp-ledger'), ticking = false;
      var check = function () {
        if (ticking) return; ticking = true;
        requestAnimationFrame(function () {
          var show = buyline.getBoundingClientRect().bottom < 0;
          if (show && ledger) {
            var lr = ledger.getBoundingClientRect();
            if (lr.top < (window.innerHeight || 0) && lr.bottom > 0) show = false;
          }
          if (show) bar.classList.add('env2-pdp-bar--show'); else bar.classList.remove('env2-pdp-bar--show');
          bar.setAttribute('aria-hidden', String(!show));
          ticking = false;
        });
      };
      window.addEventListener('scroll', check, { passive: true });
      window.addEventListener('resize', check);
      window.addEventListener('load', check);
      check();
    }

    if (priceEl) priceEl.setAttribute('data-v', priceEl.textContent.replace(/,/g, ''));
    paintFill();
    paintDevice(true);
    window.addEventListener('resize', paintFill);
    window.addEventListener('load', function () { paintFill(); paintDevice(true); });
  }

  document.querySelectorAll('[data-env2-pdp-stage]').forEach(function (el) {
    init(el);
    window.env2 ? env2.observe(el) : el.querySelectorAll('[data-lamp]').forEach(function (l) { l.classList.add('lit'); });
  });
})();
{% endjavascript %}

