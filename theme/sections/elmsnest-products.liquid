{%- comment -%}
  ElmsNest featured products — new in the 2026-09-01 rebuild.

  This section is the answer to the first fault named on the old page: it did
  not sell. The old homepage was eight screens of hero, terms, guidance and
  collection tiles, and a visitor could reach the footer without ever seeing a
  product, a price, or a way to buy. Every path to purchase went through a
  collection page first.

  So this is a real shelf: image, name, price in ₪, and — for a product with a
  single variant — a working add-to-cart that does not depend on JavaScript.
  Products with variants link to their own page instead of guessing a variant
  on the buyer's behalf, because picking «4 יח» for someone who wanted 2 is a
  worse failure than one extra click.

  Nothing here is labelled «הנמכר ביותר» or «מומלץ על ידי לקוחות». The store
  has no sales history to support either claim, and «מי אנחנו» commits to not
  presenting unverified information as fact. The heading says what this is —
  a selection someone chose — and the ordering is whatever the collection's
  own sort order is.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.limit
  if source == blank
    assign source = collections.all
  endif
-%}

{%- if source != blank and source.products_count > 0 -%}
<section id="elmsnest-products" class="en-shelf" dir="rtl" aria-labelledby="en-shelf-title-{{ section.id }}">
  <div class="en-shelf__wrap">

    <header class="en-shelf__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="en-shelf__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="en-shelf__title" id="en-shelf-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="en-shelf__all" href="{{ source.url }}">
          {{ section.settings.link_label }} <span aria-hidden="true">←</span>
        </a>
      {%- endif -%}
    </header>

    <ul class="en-shelf__grid" role="list">
      {%- for product in source.products limit: limit -%}
        {%- liquid
          assign variant = product.selected_or_first_available_variant
          assign single = false
          if product.variants.size == 1 and variant.available
            assign single = true
          endif
          assign on_sale = false
          if variant.compare_at_price > variant.price
            assign on_sale = true
          endif
        -%}
        <li class="en-card">

          <a class="en-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if product.featured_image -%}
              {{ product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300,450,600,800',
                  sizes: '(max-width:749px) 46vw, (max-width:1099px) 30vw, 23vw',
                  alt: ''
              }}
            {%- endif -%}
            {%- if on_sale -%}
              <span class="en-card__flag">{{ section.settings.sale_word }}</span>
            {%- endif -%}
          </a>

          <div class="en-card__body">
            <h3 class="en-card__name">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <p class="en-card__price">
              <bdi class="en-card__now">{{ variant.price | money }}</bdi>
              {%- if on_sale -%}
                <s class="en-card__was"><bdi>{{ variant.compare_at_price | money }}</bdi></s>
              {%- endif -%}
            </p>

            {%- comment -%}
              The buy control. A single-variant product gets a plain POST form
              so it works with scripts blocked or still loading; the theme's
              AJAX cart upgrades it when it is ready. A multi-variant product
              gets a link, never a guessed variant.
            {%- endcomment -%}
            {%- if single -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="en-card__form">
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="en-card__btn en-card__btn--buy">
                  {{ section.settings.add_label }}
                </button>
              </form>
            {%- else -%}
              <a class="en-card__btn en-card__btn--pick" href="{{ product.url }}">
                {{ section.settings.pick_label }}
              </a>
            {%- endif -%}
          </div>

        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>
{%- endif -%}

{% stylesheet %}
.en-shelf,.en-shelf *{box-sizing:border-box}
.en-shelf{
  --night:var(--en-night,43 33 24);
  --paper:var(--en-paper,255 253 247);
  --gold:var(--en-gold,217 173 95);
  --sale:var(--en-sale,145 33 42);
  direction:rtl;padding:clamp(52px,6.4vw,84px) 0;
  background:rgb(var(--paper));color:rgb(var(--night));
  scroll-margin-top:90px
}
.en-shelf__wrap{width:min(1200px,100%);margin-inline:auto;padding-inline:clamp(18px,4vw,40px)}

.en-shelf__head{
  display:flex;align-items:flex-end;justify-content:space-between;gap:20px;
  margin-bottom:clamp(24px,3.2vw,34px)
}
.en-shelf__eyebrow{margin:0 0 7px;color:rgb(var(--night)/.60);font-size:13px;font-weight:700;letter-spacing:.04em}
.en-shelf__title{
  margin:0;color:rgb(var(--night))!important;
  font-size:clamp(28px,4.2vw,46px);line-height:1.1;letter-spacing:normal;text-wrap:balance
}
.en-shelf__all{
  flex-shrink:0;color:rgb(var(--night))!important;font-weight:600;font-size:15px;
  text-decoration:none;border-block-end:1px solid rgb(var(--night)/.35);padding-block-end:3px
}
.en-shelf__all:hover{border-color:rgb(var(--night))}

.en-shelf__grid{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:clamp(14px,2vw,26px);margin:0;padding:0;list-style:none
}

.en-card{display:flex;flex-direction:column;min-width:0}
.en-card__media{
  position:relative;display:block;aspect-ratio:1/1;overflow:hidden;
  /* The photographs are night scenes on a near-white page. Without a ground
     of their own they float; the dark plate gives every card the same edge
     and lets the lit product carry the contrast. */
  background:rgb(var(--night)/.06);
  border:1px solid rgb(var(--night)/.10)
}
.en-card__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s ease}
.en-card:hover .en-card__media img{transform:scale(1.04)}
.en-card__flag{
  position:absolute;inset-block-start:0;inset-inline-start:0;
  padding:5px 11px;background:rgb(var(--sale));color:#fff;
  font-size:12px;font-weight:700;letter-spacing:.03em
}

.en-card__body{display:flex;flex-direction:column;gap:7px;padding-block-start:13px;flex:1}
.en-card__name{margin:0;font-size:15px;font-weight:500;line-height:1.45;letter-spacing:normal}
.en-card__name a{color:rgb(var(--night))!important;text-decoration:none}
.en-card__name a:hover{text-decoration:underline;text-underline-offset:3px}
.en-card__price{display:flex;align-items:baseline;gap:9px;margin:0;font-variant-numeric:tabular-nums}
.en-card__now{font-size:18px;font-weight:700;color:rgb(var(--night))}
.en-card__was{color:rgb(var(--night)/.48);font-size:14px}

.en-card__form{margin:0;margin-block-start:auto;padding-block-start:11px}
.en-card__btn{
  display:flex;align-items:center;justify-content:center;width:100%;
  min-height:46px;padding:11px 16px;border-radius:0;cursor:pointer;
  font-family:inherit;font-size:15px;font-weight:600;text-decoration:none;
  transition:background-color .18s ease,color .18s ease,border-color .18s ease
}
.en-card__btn--buy{
  border:1px solid rgb(var(--night));background:rgb(var(--night));color:rgb(var(--paper))!important
}
.en-card__btn--buy:hover{background:rgb(var(--gold));border-color:rgb(var(--gold));color:rgb(var(--night))!important}
.en-card__btn--pick{
  margin-block-start:auto;
  border:1px solid rgb(var(--night)/.42);background:transparent;color:rgb(var(--night))!important
}
.en-card__btn--pick:hover{border-color:rgb(var(--night));background:rgb(var(--night)/.06)}
.en-card__btn:focus-visible{outline:3px solid rgb(var(--night));outline-offset:2px}

@media(max-width:1099px){.en-shelf__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){
  .en-shelf__wrap{padding-inline:16px}
  .en-shelf__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 12px}
  .en-shelf__head{flex-direction:column;align-items:flex-start;gap:12px}
  .en-card__name{font-size:14px}
  .en-card__now{font-size:16px}
}
@media(prefers-reduced-motion:reduce){
  .en-card__media img,.en-card__btn{transition:none}
  .en-card:hover .en-card__media img{transform:none}
}
{% endstylesheet %}

{% schema %}
{
  "name": "ElmsNest products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "שורת פתיחה", "default": "אפשר להתחיל מכאן" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מוצרים נבחרים" },
    { "type": "collection", "id": "collection", "label": "קולקציה", "info": "ברירת מחדל: כל המוצרים. הסדר נקבע לפי סדר המיון של הקולקציה." },
    { "type": "range", "id": "limit", "label": "כמה מוצרים", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "link_label", "label": "קישור לקולקציה", "default": "לכל הקולקציה" },
    { "type": "header", "content": "כפתורים ותוויות" },
    { "type": "text", "id": "add_label", "label": "מוצר עם דגם אחד", "default": "הוספה לסל" },
    { "type": "text", "id": "pick_label", "label": "מוצר עם כמה דגמים", "default": "בחירת דגם" },
    { "type": "text", "id": "sale_word", "label": "תווית מבצע", "default": "מבצע" }
  ],
  "presets": [{ "name": "ElmsNest products" }]
}
{% endschema %}
