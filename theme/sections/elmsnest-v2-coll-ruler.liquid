    { "type": "header", "content": "יחידת המידה" },
    { "type": "select", "id": "unit_mode", "label": "הסרגל נמדד ב", "default": "auto",
      "options": [
        { "value": "auto", "label": "אוטומטי — לפי האפשרויות של המוצרים" },
        { "value": "length", "label": "מטרים" },
        { "value": "count", "label": "נקודות אור / יחידות" },
        { "value": "price", "label": "מחיר כניסה" },
        { "value": "mixed", "label": "תוכן עניינים (לכל הקטלוג)" }
      ],
      "info": "אוטומטי בוחר מטרים או יחידות רק כששני מוצרים לפחות באמת נמדדים כך, אחרת מחיר. לעמוד «כל המוצרים» — תוכן עניינים." },
    { "type": "text", "id": "unit_word", "label": "שם היחידה ברבים", "info": "ריק = מטרים / נקודות אור לפי המצב. מופיע במשפט שמתחת למספר." },
    { "type": "text", "id": "unit_short", "label": "קיצור היחידה על הכפתורים", "info": "ריק = מ׳ / נקודות." },
    { "type": "text", "id": "stops", "label": "עצירות הסרגל", "info": "ריק = נבנות מהמידות שהמוצרים באמת נמכרים בהן. אפשר לרשום רשימה מופרדת בפסיקים, למשל 3,6,10,15,22,30." },
    { "type": "range", "id": "stops_max", "label": "כמה עצירות (מלבד «הכול»)", "min": 4, "max": 7, "step": 1, "default": 6 },
    { "type": "text", "id": "rail_max", "label": "קצה הסרגל", "info": "ריק = המידה הגדולה ביותר שקיימת בקולקציה." },
    { "type": "checkbox", "id": "show_unit_price", "label": "להציג מחיר ליחידה", "default": true, "info": "מחושב מהמחיר של הווריאציה חלקי מספר היחידות שבה, תמיד עם ≈." },
    { "type": "text", "id": "per_unit_word", "label": "המילה למחיר ליחידה", "info": "ריק = ₪ למטר / ₪ ליחידה. בשביל: ₪ לנקודת אור." },
    { "type": "header", "content": "הטקסטים" },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה קטנה", "default": "המקום — והמידה" },
    { "type": "text", "id": "heading", "label": "כותרת", "info": "ריק = השאלה של המקום, לפי הקולקציה." },
    { "type": "textarea", "id": "deck", "label": "שורת פתיחה", "info": "בקולקציות שבהן העמוד באמת מספק את הבחירה — הפסקה השנייה מתיאור הקולקציה. בקיר ובספוטים היא לא מודפסת." },
    { "type": "text", "id": "question", "label": "השאלה שמעל הכפתורים", "info": "ריק = לפי יחידת המידה." },
    { "type": "text", "id": "action_label", "label": "טקסט הכפתור בשורה", "info": "ריק = לבחירת אורך / לבחירת כמות / לבחירת דגם. מוצר עם אפשרות אחת מקבל «הוספה לסל»." },
