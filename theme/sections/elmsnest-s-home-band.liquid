{%- comment -%}
  ElmsNest S — the breath (HOME2 SPEC §1 C). Home only.
  One full-bleed photograph, edge to edge at every width (min-block-size 520 px at 390,
  560 px at ≥ 901), and ONE sentence «חושך הוא לא סוף הערב.» in glow serif at the bottom
  inline-start inside the wrap. No eyebrow, no link, no button, no heading, no card chrome,
  no motion. The photograph is the store's own product frame (own_solar-crystal-ball-string-
  lights_5 → assets/ens-home-fence.jpg, 1254×1254: crystal bulbs on a picket fence at blue
  hour) — store-owned, no credit line owed. An owner-picked image (image_picker) replaces the
  theme asset; an empty picker renders the asset. The sentence sits on the dark fence; a bottom
  fade of at most 30 % of the frame is kept behind a checkbox for the 4.5:1 floor.
  Tokens come from elmsnest-v2-core (global); this file only adds ens-home-band* rules.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign ens_op = section.settings.object_position | default: '50% 50%' | strip | escape
  assign ens_op_lg = section.settings.object_position_desktop | default: '50% 60%' | strip | escape
  comment
    Picker srcset: the widths are capped against the source width (the hero's R26 rule),
    so a narrower owner image never gets a descriptor the CDN cannot honour.
  endcomment
  assign ens_srcset = ''
  assign ens_want = '600,900,1200,1600' | split: ','
  for w in ens_want
    assign wn = w | plus: 0
    if img != blank and wn <= img.width
      assign wurl = img | image_url: width: wn
      if ens_srcset != ''
        assign ens_srcset = ens_srcset | append: ', '
      endif
      assign ens_srcset = ens_srcset | append: wurl | append: ' ' | append: w | append: 'w'
    endif
  endfor
  if ens_srcset == '' and img != blank
    assign wurl = img | image_url: width: 600
    assign ens_srcset = wurl | append: ' 600w'
  endif
-%}
<section class="env2-section ens-home-band" dir="rtl"{% if section.settings.sentence != blank %} aria-labelledby="ens-home-band-p-{{ section.id }}"{% else %} aria-label="נשימה"{% endif %} style="scroll-margin-top:90px">
  <figure class="ens-home-band__fig{% if section.settings.show_fade %} ens-home-band__fig--fade{% endif %}" style="--ens-op:{{ ens_op }};--ens-op-lg:{{ ens_op_lg }}">
    {%- if img != blank -%}
      <img
        src="{{ img | image_url: width: 1600 }}"
        srcset="{{ ens_srcset }}"
        sizes="100vw"
        width="{{ img.width }}" height="{{ img.height }}"
        loading="lazy" decoding="async" alt="">
    {%- else -%}
      <img
        src="{{ 'ens-home-fence.jpg' | asset_img_url: '1254x' }}"
        srcset="{{ 'ens-home-fence.jpg' | asset_img_url: '600x' }} 600w, {{ 'ens-home-fence.jpg' | asset_img_url: '900x' }} 900w, {{ 'ens-home-fence.jpg' | asset_img_url: '1200x' }} 1200w, {{ 'ens-home-fence.jpg' | asset_img_url: '1254x' }} 1254w"
        sizes="100vw"
        width="1254" height="1254"
        loading="lazy" decoding="async" alt="">
    {%- endif -%}
    {%- if section.settings.sentence != blank -%}
    <figcaption class="ens-home-band__cap">
      <p id="ens-home-band-p-{{ section.id }}" class="env2-h ens-home-band__h">{{ section.settings.sentence | escape }}</p>
    </figcaption>
    {%- endif -%}
  </figure>
</section>

<style>
.ens-home-band{padding:0;margin:0;isolation:isolate}
.ens-home-band__fig{position:relative;margin:0;min-block-size:520px;overflow:hidden;background:#05070c;border:0;border-radius:0}
/* crop per section (object_position / object_position_desktop settings, defaults 50% 50% / 50% 60%) */
.ens-home-band__fig img{position:absolute;inset:0;display:block;inline-size:100%;block-size:100%;object-fit:cover;object-position:var(--ens-op,50% 50%)}
/* the 30 % bottom fade (show_fade): the sentence sits on the dark fence, the fade only guards the 4.5:1 floor */
.ens-home-band__fig--fade::after{content:"";position:absolute;inset-inline:0;inset-block-end:0;block-size:30%;pointer-events:none;background:linear-gradient(180deg,rgba(2,3,6,0) 0%,rgba(2,3,6,.55) 100%)}
.ens-home-band__cap{position:absolute;inset-inline:0;inset-block-end:40px;z-index:1;margin:0;width:min(var(--env2-w),100% - 2*var(--env2-gut));margin-inline:auto;text-align:start;pointer-events:none}
.ens-home-band__h.env2-h{font-size:34px;line-height:1.06;color:var(--env2-glow);max-inline-size:12ch;text-shadow:0 2px 24px rgba(2,3,6,.6);margin:0}
@media (min-width:901px){
  .ens-home-band__fig{min-block-size:560px}
  .ens-home-band__fig img{object-position:var(--ens-op-lg,50% 60%)}
  .ens-home-band__cap{inset-block-end:56px}
  .ens-home-band__h.env2-h{font-size:52px;max-inline-size:14ch}
}
@media (prefers-reduced-motion:reduce){
  .ens-home-band__fig img{transition:none}
}
</style>

{% schema %}
{
  "name": "ElmsNest S — נשימה",
  "class": "ens-home-section hdt-section",
  "settings": [
    { "type": "text", "id": "sentence", "label": "המשפט", "default": "חושך הוא לא סוף הערב." },
    { "type": "image_picker", "id": "image", "label": "תמונה (ריק = ens-home-fence.jpg)", "info": "ריק = תמונת הגדר של החנות בשעת בין ערביים (מקבצי הערכה)." },
    { "type": "text", "id": "object_position", "label": "מיקום החיתוך בנייד (object-position)", "default": "50% 50%", "info": "לדוגמה 30% 50% כדי להצמיד לצד התמונה. נקודת מיקוד מממשק הניהול אינה חלה כאן." },
    { "type": "text", "id": "object_position_desktop", "label": "מיקום החיתוך במחשב (object-position)", "default": "50% 60%", "info": "חל מרוחב 901 פיקסלים." },
    { "type": "checkbox", "id": "show_fade", "label": "דהייה קלה בתחתית התמונה (עד 30%)", "default": true, "info": "רק כדי שהמשפט יישאר קריא על תמונה בהירה. המשפט יושב על הגדר הכהה." }
  ],
  "presets": [
    { "name": "ElmsNest S — נשימה" }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
