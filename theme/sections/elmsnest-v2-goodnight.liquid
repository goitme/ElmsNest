{%- comment -%}
  ElmsNest v2 — §4.8 "לילה טוב" (full night; sits directly above the Kalles footer).
  The garden from the decor collection reappears at the bottom of the section, lit, under stars;
  one line + the WhatsApp pill (the photo-check promise) at the start, the two social icons at the
  end; then, 150 px lower, one hairline carrying the consumer terms (G11 — found a second time,
  after the ledger) running from the start edge up to the outlined "לילה טוב" at the end side.
  No columns, no lists — those belong to the Kalles footer below.
  Motion: the section root is the lamp. The garden is at opacity 0 under html.env2-js and fades
  to .95 over 2.4 s when the section is reached (calc(.95*var(--lit))); the word's outline brightens
  with the same variable (.3 → .65, 1.5 px) but is NEVER filled (§3.2 / §7.9). Reduced motion: lit at once.
  WhatsApp pill: the glyph + label only when the href really is a wa.me link; with no number anywhere
  the pill falls back to /pages/contact-us and reads "לשליחת תמונה" with no glyph (R02).
  Shared plumbing (fonts/base) is rendered by elmsnest-v2-hero; this section assumes it and
  still renders lit without it (see the JS tail).
  Bidi: digit-leading tokens of the strip ("8–17", "14") are wrapped in <bdi> at render time.
{%- endcomment -%}
{%- capture photo_url -%}{%- render 'elmsnest-v2-photo-url' -%}{%- endcapture -%}
{%- liquid
  assign wa_text = 'שלום, אשמח לבדוק התאמה — מצרף/ת תמונה של המקום.' | url_encode
  assign wa_href = photo_url | strip
  if section.settings.whatsapp_url != blank and section.settings.whatsapp_url != 'https://wa.me/'
    assign wa_href = section.settings.whatsapp_url | append: '?text=' | append: wa_text
  endif

  assign garden = section.settings.image
  if garden == blank and section.settings.collection != blank
    assign garden = section.settings.collection.featured_image
  endif

  assign ig = section.settings.instagram_url | default: settings.social_instagram_link
  assign tt = section.settings.tiktok_url | default: settings.social_tiktok_link

  assign big_word = section.settings.big_word | default: 'לילה טוב'
  assign strip_link = section.settings.strip_link | default: '#env2-terms'
  assign strip_items = section.settings.strip_text | strip | escape | split: ' · '
  assign digits = '0123456789'
-%}
<section id="env2-goodnight" data-env2-goodnight data-lamp class="env2-section env2-goodnight" dir="rtl" style="scroll-margin-top:90px;--env2-stars:.7" aria-label="{{ big_word | escape }}">
  <div class="env2-stars" aria-hidden="true"></div>

  {%- if garden != blank -%}
    <div class="env2-goodnight__garden" aria-hidden="true">
      {{ garden | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '900,1400,1800,2400', sizes: '100vw', alt: '', class: 'env2-goodnight__img' }}
    </div>
  {%- endif -%}

  <div class="env2-wrap env2-goodnight__wrap">

    <div class="env2-goodnight__top">
      <div class="env2-goodnight__promise">
        {%- if section.settings.line != blank -%}
          <p class="env2-goodnight__line">{{ section.settings.line }}</p>
        {%- endif -%}
        {%- if wa_href contains 'wa.me' -%}
          <a class="env2-btn env2-btn--ghost env2-goodnight__wa" href="{{ wa_href }}" target="_blank" rel="noopener">
            <svg class="env2-goodnight__wa-ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20l1.3-3.8A8 8 0 1 1 8.2 19L4 20z"/><path class="env2-goodnight__wa-fill" d="M9.5 9c.2 1.8 2 3.6 3.9 4l1.1-1.1-1.7-.8-.6.6c-.6-.3-1.2-.9-1.5-1.5l.6-.6-.8-1.7L9.5 9z"/></svg>
            <span>{{ section.settings.whatsapp_label | default: 'וואטסאפ' }}</span>
          </a>
        {%- else -%}
          <a class="env2-btn env2-btn--ghost env2-goodnight__wa" href="{{ wa_href }}">
            <span>לשליחת תמונה</span>
          </a>
        {%- endif -%}
      </div>

      {%- if ig != blank or tt != blank -%}
        <nav class="env2-goodnight__soc" aria-label="רשתות חברתיות">
          {%- if ig != blank -%}
            <a class="env2-goodnight__soc-a" href="{{ ig }}" target="_blank" rel="noopener" aria-label="אינסטגרם">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="env2-goodnight__soc-dot" cx="17.3" cy="6.7" r=".8"/></svg>
            </a>
          {%- endif -%}
          {%- if tt != blank -%}
            <a class="env2-goodnight__soc-a" href="{{ tt }}" target="_blank" rel="noopener" aria-label="טיקטוק">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2 4.2 4.5 4.5"/></svg>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="env2-goodnight__bottom">
      {%- if strip_items.size > 0 -%}
        <p class="env2-goodnight__strip">
          {%- for item in strip_items -%}
            {%- liquid
              assign item_html = ''
              assign words = item | strip | split: ' '
              for w in words
                assign c = w | slice: 0, 1
                if c != blank and digits contains c
                  assign tok = '<bdi>' | append: w | append: '</bdi>'
                else
                  assign tok = w
                endif
                if forloop.first
                  assign item_html = tok
                else
                  assign item_html = item_html | append: ' ' | append: tok
                endif
              endfor
            -%}
            {%- if forloop.last and strip_link != blank and strip_items.size > 1 -%}
              <a class="env2-goodnight__strip-a" href="{{ strip_link }}">{{ item_html }}</a>
            {%- else -%}
              <span class="env2-goodnight__strip-i">{{ item_html }}</span>
            {%- endif -%}
            {%- unless forloop.last -%}<span class="env2-goodnight__dot" aria-hidden="true">·</span>{%- endunless -%}
          {%- endfor -%}
        </p>
      {%- endif -%}
      <p class="env2-goodnight__big" aria-hidden="true">{{ big_word }}</p>
    </div>

  </div>
</section>

{% stylesheet %}
/* ---------- §4.8 goodnight: full night — the garden lit under stars, one line, one hairline, one outlined word ----------
   note: this bundle loads in <head> BEFORE the base inline style; anything overriding a base helper
   (.env2-btn …) needs higher specificity, not later source order. */
.env2-goodnight{padding-block:150px 40px;isolation:isolate;overflow:hidden}
.env2-goodnight__wrap{position:relative;z-index:1}

/* the garden: bottom 78 % of the section, at 95 % opacity once lit, under a thin night veil (heavier only at the top seam and the footer edge);
   a warm multiply layer (glow colour, inside the garden's own stacking context) so the bulbs' clipped cores read as warm points, not grey discs */
.env2-goodnight__garden{position:absolute;inset:auto 0 0 0;height:78%;z-index:-1;pointer-events:none;opacity:calc(.95*var(--lit,1));transition:opacity 2.4s cubic-bezier(.2,.7,.2,1);-webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,0) 0,#000 34%);mask-image:linear-gradient(180deg,rgba(0,0,0,0) 0,#000 34%)}
.env2-goodnight__garden::before{content:"";position:absolute;inset:0;z-index:1;background:rgba(255,211,148,.45);mix-blend-mode:multiply}
.env2-goodnight__garden::after{content:"";position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,rgba(2,3,6,.45) 0,rgba(2,3,6,.08) 40%,rgba(2,3,6,.5) 100%)}
.env2-goodnight__img{width:100%;height:100%;object-fit:cover;object-position:50% 62%;display:block;filter:saturate(1.1) contrast(1.06) brightness(1.16)}

/* row 1: the promise + WhatsApp pill at the start, the two social circles at the end */
.env2-goodnight__top{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:24px 40px}
.env2-goodnight__promise{display:flex;flex-wrap:wrap;align-items:center;gap:18px 28px;min-width:0}
.env2-goodnight__line{margin:0;font-family:var(--env2-sans);font-weight:300;font-size:clamp(17px,1.4vw,20px);line-height:1.45;color:var(--env2-ink);max-width:46ch;text-wrap:balance}
.env2-goodnight__wa{flex:none}
.env2-goodnight__wa-ic{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.env2-goodnight__wa-fill{fill:currentColor;stroke:none}
.env2-goodnight__soc{display:flex;gap:14px;justify-self:end}
.env2-goodnight__soc-a{width:40px;height:40px;border:1px solid var(--env2-hair-btn);border-radius:50%;display:grid;place-items:center;color:var(--env2-ink);transition:border-color .3s,color .3s,transform .35s cubic-bezier(.2,.8,.2,1)}
.env2-goodnight__soc-a:hover,.env2-goodnight__soc-a:focus-visible{border-color:var(--env2-glow);color:var(--env2-glow);transform:translateY(-2px);text-decoration:none}
.env2-goodnight__soc-a svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.env2-goodnight__soc-dot{fill:currentColor;stroke:none}

/* row 2: one hairline runs from the start edge to the word; the terms ride on it; the word closes it at the end */
.env2-goodnight__bottom{margin-top:150px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px 40px}
.env2-goodnight__strip{flex:1 1 auto;min-width:0;margin:0;padding-top:16px;border-top:1px solid var(--env2-hair);display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px;font-family:var(--env2-sans);font-weight:400;font-size:12.5px;line-height:1.5;letter-spacing:.02em;color:var(--env2-mute)}
.env2-goodnight__strip-i{white-space:nowrap}
.env2-goodnight__strip bdi{unicode-bidi:isolate;font-variant-numeric:tabular-nums}
.env2-goodnight__dot{color:var(--env2-mute);opacity:.6}
.env2-goodnight__strip-a{white-space:nowrap;color:var(--env2-ink-2);border-bottom:1px solid rgba(143,149,163,.45);padding-bottom:2px;text-decoration:none;transition:color .3s,border-color .3s}
.env2-goodnight__strip-a:hover,.env2-goodnight__strip-a:focus-visible{color:var(--env2-glow);border-color:var(--env2-glow);text-decoration:none}

/* the word: outline only, never filled; the 1.5 px stroke brightens with the lamp (.3 → .65), a faint breath of glow behind it */
.env2-goodnight__big{flex:none;margin:0;font-family:var(--env2-serif);font-weight:900;font-size:clamp(48px,9vw,140px);line-height:.85;letter-spacing:.02em;color:transparent;-webkit-text-stroke:1.5px rgba(244,238,227,calc(.3 + .35*var(--lit,1)));text-shadow:0 0 34px rgba(255,211,148,calc(.12*var(--lit,1)));transition:-webkit-text-stroke-color 2.4s .4s,text-shadow 2.4s .4s;transform:translateY(.06em);white-space:nowrap;user-select:none}

/* ---------- mobile: line, pill, socials, then the word, then the strip reduced to its link (R11) ---------- */
@media (max-width:900px){
  .env2-goodnight{padding-block:64px 28px}
  .env2-goodnight__garden{height:72%}
  .env2-goodnight__img{object-position:50% 70%}
  .env2-goodnight__top{grid-template-columns:1fr;gap:26px}
  .env2-goodnight__promise{gap:16px}
  .env2-goodnight__line{font-size:17px;max-width:none}
  .env2-goodnight__soc{justify-self:start}
  .env2-goodnight__bottom{margin-top:80px;flex-direction:column;align-items:flex-start;gap:22px}
  .env2-goodnight__big{order:1;font-size:48px;transform:none;line-height:.9}
  .env2-goodnight__strip{order:2;width:100%;flex:none;padding-top:14px;gap:6px 8px;font-size:13.5px}
  .env2-goodnight__strip-i,.env2-goodnight__dot{display:none}
  .env2-goodnight__strip-i:only-child{display:inline}
  .env2-goodnight__strip-a{padding-block:8px}
}
{% endstylesheet %}

{% javascript %}
/* §4.8 goodnight: the section root is the lamp — hand it to the shared observer (the garden fades in
   over 2.4 s when the section is reached); without the base, light it at once so the page never
   ends on a black hole. */
(function(){
  function init(el){
    if (el.__env2Goodnight) return;
    el.__env2Goodnight = true;
    if (window.env2 && window.env2.observe) {
      window.env2.observe(el);
    } else {
      if (el.hasAttribute('data-lamp')) el.classList.add('lit');
      el.querySelectorAll('[data-lamp]').forEach(function(l){ l.classList.add('lit'); });
    }
  }
  function boot(root){
    (root && root.querySelectorAll ? root : document).querySelectorAll('[data-env2-goodnight]').forEach(init);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ boot(document); });
  else boot(document);
  document.addEventListener('shopify:section:load', function(e){ boot(e.target || document); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "ElmsNest v2 — לילה טוב",
  "settings": [
    { "type": "header", "content": "הגינה (תמונת הרקע בתחתית)" },
    { "type": "collection", "id": "collection", "label": "קולקציה שתמונתה היא הגינה", "info": "ברירת מחדל: גרילנדות ותאורה דקורטיבית (גרילנדה מתחת לעץ). התמונה נדלקת כשמגיעים לסוף העמוד." },
    { "type": "image_picker", "id": "image", "label": "תמונה חלופית (דורסת את תמונת הקולקציה)" },
    { "type": "header", "content": "השורה והוואטסאפ" },
    { "type": "text", "id": "line", "label": "השורה", "default": "שלחו תמונה של המקום — נבדוק התאמה לפני ההזמנה." },
    { "type": "text", "id": "whatsapp_label", "label": "טקסט הכפתור", "default": "וואטסאפ" },
    { "type": "text", "id": "whatsapp_url", "label": "קישור וואטסאפ — כתובת (https://wa.me/972…)", "default": "https://wa.me/", "info": "אם נשאר ריק או ברירת מחדל — נלקח מהמספר בהגדרות הערכה, ואם אין — עמוד יצירת קשר." },
    { "type": "header", "content": "המילה הגדולה ורצועת התנאים" },
    { "type": "text", "id": "big_word", "label": "המילה הגדולה (קו מתאר בלבד, דקורטיבית)", "default": "לילה טוב" },
    { "type": "text", "id": "strip_text", "label": "רצועת התנאים (פריטים מופרדים ב־ · )", "default": "משלוח חינם לנקודת איסוף · 8–17 ימי עסקים · ביטול תוך 14 יום לפי חוק הגנת הצרכן · לתנאים המלאים ←", "info": "הפריט האחרון הופך לקישור (ראו למטה). מספרים וטווחים (למשל 8–17) נשמרים בכיוון הנכון אוטומטית." },
    { "type": "url", "id": "strip_link", "label": "יעד הקישור של הפריט האחרון", "info": "ברירת מחדל: #env2-terms — ארבעת המספרים למעלה באותו עמוד." },
    { "type": "header", "content": "רשתות חברתיות (רק כתובות אמיתיות; ריק = לא מוצג)" },
    { "type": "url", "id": "instagram_url", "label": "אינסטגרם", "info": "ריק = הכתובת מהגדרות הערכה (Social media), אם קיימת." },
    { "type": "url", "id": "tiktok_url", "label": "טיקטוק", "info": "ריק = הכתובת מהגדרות הערכה (Social media), אם קיימת." }
  ],
  "presets": [
    { "name": "ElmsNest v2 — לילה טוב" }
  ]
}
{% endschema %}
