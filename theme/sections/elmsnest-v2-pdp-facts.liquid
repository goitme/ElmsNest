    { "type": "text", "id": "giant_text", "label": "טקסט קבוע (ריק = אוטומטי)", "info": "חל על כל המוצרים בתבנית — עדיף להשאיר ריק." },
    { "type": "textarea", "id": "giant_sub", "label": "המשפט שמתחתיו (ריק = משפט מתיאור המוצר)" },
    { "type": "header", "content": "מה שלא כתוב" },
    { "type": "paragraph", "content": "השורה הזאת היא העמדה של החנות: מה שאינו מופיע בנתוני המוצר נאמר במפורש. הנוסח מחושב מהנתונים עצמם ולכן לעולם אינו טוען שחסר משהו שכן כתוב בתיאור." },
    { "type": "checkbox", "id": "show_unknown_row", "label": "להציג את השורה", "default": true },
    { "type": "text", "id": "unknown_row_label", "label": "תווית השורה", "default": "מה שלא כתוב" },
    { "type": "textarea", "id": "unknown_row_text", "label": "נוסח קבוע (ריק = מחושב לכל מוצר)" },
    { "type": "header", "content": "התיאור המלא" },
    { "type": "checkbox", "id": "show_full_description", "label": "לשמור את תיאור המוצר המקורי", "default": true },
    { "type": "text", "id": "more_label", "label": "תווית הפתיחה", "default": "כל מה שכתוב על המוצר" }
