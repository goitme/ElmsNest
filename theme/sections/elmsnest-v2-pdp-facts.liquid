    { "type": "text", "id": "question", "label": "השאלה", "default": "ומה יכול להשתבש?", "info": "נכתבת בגרשיים «…» אוטומטית." },
    { "type": "textarea", "id": "deck", "label": "משפט הפתיחה", "default": "מה שכתוב כאן — נכון. מה שלא ידוע — לא כתוב." },
    { "type": "header", "content": "העובדות" },
    { "type": "paragraph", "content": "השורות נלקחות מנתוני המוצר עצמו: קודם הבולטים שתחת «פרטים שכדאי לדעת», אחריהם שורת «פרטים טכניים», ואחריהם שדות המטה־פילד. כשאין אף אחד מהם — הטבלה פשוט לא מוצגת. אין לכתוב כאן עובדה שאינה בנתוני המוצר." },
    { "type": "select", "id": "source", "label": "מקור", "options": [ { "value": "description_bullets", "label": "מתיאור המוצר (מומלץ)" }, { "value": "blocks", "label": "מהבלוקים בלבד" } ], "default": "description_bullets" },
    { "type": "range", "id": "max_rows", "label": "מקסימום שורות מהתיאור", "min": 3, "max": 14, "step": 1, "default": 10 },
    { "type": "text", "id": "bullets_heading", "label": "הכותרת שאחריה הבולטים", "default": "פרטים שכדאי לדעת" },
    { "type": "text", "id": "specs_heading", "label": "הכותרת שאחריה שורת המפרט", "default": "פרטים טכניים" },
