{%- comment -%}
  ElmsNest v2 — §4.3 "ארבעה מקומות. קטגוריה אחת." (the four places).
  The four collections as a staggered staircase of night scenes: four different aspects,
  four different lifts, oversized serif numerals INSIDE each photo's top-start corner
  (outline until the lamp lights, then glow) — a collections section that is not four
  equal boxes. Mobile: a horizontal snap scroller, nothing overhangs the viewport edge.
  Shared plumbing (fonts/base snippets) is rendered by elmsnest-v2-hero; this section
  assumes it and degrades to "everything lit" without it.
  Crop control: set the focal point on the collection image in the Shopify admin —
  image_tag writes it as object-position.
{%- endcomment -%}
{%- liquid
  assign env2_all_count = '<bdi>' | append: collections.all.products_count | append: '</bdi>'
  assign env2_all_label = section.settings.all_label | default: 'לכל [count] המוצרים' | escape | replace: '[count]', env2_all_count
  assign env2_all_link = section.settings.all_link | default: '/collections/all'
-%}
<section id="env2-places" data-env2-places class="env2-section env2-places" dir="rtl" style="scroll-margin-top:90px;--env2-stars:.18">
  <div class="env2-stars" aria-hidden="true"></div>

  <div class="env2-wrap env2-places__head">
    <h2 class="env2-h env2-places__h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="env2-places__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <div class="env2-places__strip">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign img = block.settings.image | default: col.featured_image
        assign ar = block.settings.aspect | default: '3/4'
        assign lift = block.settings.lift | default: 0
        assign lift_m = lift | times: 0.6 | round
        assign place_title = block.settings.title_short | default: col.title
        assign alt = img.alt | default: col.title | default: place_title
        assign href = col.url | default: '/collections/all'
      -%}
      <a class="env2-places__place" href="{{ href }}" data-lamp style="--env2-places-ar:{{ ar }};--env2-places-lift:{{ lift }}px;--env2-places-lift-m:{{ lift_m }}px" {{ block.shopify_attributes }}>
        <span class="env2-ph env2-places__ph">
          <span class="env2-places__num" aria-hidden="true">{{ forloop.index }}</span>
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1600', sizes: '(max-width: 900px) 80vw, (max-width: 1500px) 40vw, 600px', alt: alt }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'env2-places__placeholder' }}
          {%- endif -%}
        </span>
        <span class="env2-places__cap">
          <span class="env2-places__txt">
            <b class="env2-places__t">{{ place_title | default: 'בחרו קולקציה' }}</b>
            {%- if block.settings.subtitle != blank -%}
              <small class="env2-places__sub">{{ block.settings.subtitle }}</small>
            {%- endif -%}
          </span>
          {%- if col != blank -%}
            <span class="env2-places__count"><bdi>{{ col.products_count }}</bdi> מוצרים</span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>

  <div class="env2-wrap env2-places__after">
    <a class="env2-link env2-places__all" href="{{ env2_all_link }}">{{ env2_all_label }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a>
  </div>
</section>

{% stylesheet %}
/* ---------- §4.3 places: a staircase of four night scenes, numerals inside the photos ----------
   note: this bundle loads in <head> BEFORE the base inline style, so anything overriding a base
   helper (.env2-h, [data-lamp] .env2-ph …) needs higher specificity, not later source order. */
.env2-places{padding-block:120px 100px;overflow:clip}
.env2-places__head{position:relative;z-index:1;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:baseline;gap:40px;margin-bottom:56px}
.env2-places__h2.env2-h{font-size:clamp(40px,5.6vw,84px);max-width:14ch}
.env2-places__intro{justify-self:end;text-align:end;max-width:40ch;margin:0;font-size:16px;line-height:1.55;color:var(--env2-ink-2)}

/* the strip: wider than the page container; four columns of different widths, bottom-aligned,
   each step lifted by its own amount (0 / 60 / 24 / 100 by default) — a staircase, not a row */
.env2-places__strip{position:relative;z-index:1;width:min(1500px,100% - 2*var(--env2-gut));margin-inline:auto;display:grid;grid-template-columns:1.55fr .95fr 1.3fr .85fr;gap:14px;align-items:end}
.env2-places__place{position:relative;display:block;min-width:0;margin:0 0 var(--env2-places-lift,0px);color:inherit;text-decoration:none}
.env2-places__ph{display:block;aspect-ratio:var(--env2-places-ar,3/4)}
.env2-places__placeholder{display:block;width:100%;height:100%;opacity:.35}

/* the numeral: INSIDE the photo's top-start corner (never overhangs the viewport), outline only
   while the lamp is dim, glow fill + a dark drop so it reads over bright zones once lit.
   Driven by --lit (1 without JS, 0 → 1 when the lamp lights) so it follows the photo. */
.env2-places__num{position:absolute;top:.04em;inset-inline-start:.06em;z-index:2;pointer-events:none;user-select:none;font-family:var(--env2-serif);font-weight:900;font-size:clamp(90px,10vw,170px);line-height:1;color:rgba(255,211,148,var(--lit,1));-webkit-text-stroke:1px rgba(244,238,227,calc(.45 - .45*var(--lit,1)));text-shadow:0 2px 24px rgba(0,0,0,calc(.6*var(--lit,1))),0 0 30px rgba(255,211,148,calc(.5*var(--lit,1)));transition:color 1.2s .3s,-webkit-text-stroke-color 1.2s .3s,text-shadow 1.2s .3s}

/* caption under each photo: serif name, small subtitle, count at the end */
.env2-places__cap{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin-top:16px}
.env2-places__txt{display:block;min-width:0}
.env2-places__t{display:block;font-family:var(--env2-serif);font-weight:500;font-size:30px;line-height:1;color:var(--env2-ink);transition:color .3s}
.env2-places__sub{display:block;margin-top:6px;font-family:var(--env2-sans);font-weight:300;font-size:13px;line-height:1.4;color:var(--env2-ink-2)}
.env2-places__count{flex:none;font-family:var(--env2-sans);font-size:12.5px;letter-spacing:.04em;white-space:nowrap;color:rgba(201,196,184,.78)}
.env2-places__place:hover .env2-places__t,.env2-places__place:focus-visible .env2-places__t{color:var(--env2-glow)}

.env2-places__after{position:relative;z-index:1;margin-top:56px;display:flex;justify-content:center}
.env2-places__all svg{width:14px;height:14px;flex:none}

/* ---------- mobile: a horizontal snap scroller, nothing overhangs the viewport edge (dusk 331–343) ---------- */
@media (max-width:900px){
  .env2-places{padding-block:72px 56px}
  .env2-places__head{grid-template-columns:1fr;gap:14px;margin-bottom:32px}
  .env2-places__intro{justify-self:start;text-align:start}
  .env2-places__strip{display:flex;width:auto;margin-inline:0;padding-inline:var(--env2-gut);padding-bottom:4px;gap:16px;align-items:flex-end;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-padding-inline:var(--env2-gut);scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .env2-places__strip::-webkit-scrollbar{display:none}
  .env2-places__strip::after{content:"";flex:0 0 1px;margin-inline-start:-16px}
  .env2-places__place{flex:0 0 auto;scroll-snap-align:start;width:76vw;margin-bottom:var(--env2-places-lift-m,0px)}
  .env2-places__place:nth-child(1) .env2-places__ph{aspect-ratio:4/5}
  .env2-places__place:nth-child(2){width:60vw}
  .env2-places__place:nth-child(2) .env2-places__ph{aspect-ratio:3/4.4}
  .env2-places__place:nth-child(3){width:80vw}
  .env2-places__place:nth-child(3) .env2-places__ph{aspect-ratio:4/3.6}
  .env2-places__place:nth-child(4){width:62vw}
  .env2-places__place:nth-child(4) .env2-places__ph{aspect-ratio:3/4}
  .env2-places__num{font-size:88px}
  .env2-places__t{font-size:24px}
  .env2-places__sub{font-size:12.5px}
  .env2-places__after{margin-top:32px;justify-content:flex-start}
}
{% endstylesheet %}

{% javascript %}
/* §4.3 places: nothing to run but the lamps. Hand them to the shared observer; without the
   base (a page without the hero) render everything lit. In the theme editor, selecting a
   block lights it and scrolls the mobile strip to it. */
(function(){
  function init(el){
    if (el.__env2Places) return;
    el.__env2Places = true;
    if (window.env2 && window.env2.observe) {
      window.env2.observe(el);
    } else {
      el.querySelectorAll('[data-lamp]').forEach(function(l){ l.classList.add('lit'); });
    }
  }
  function boot(root){
    (root && root.querySelectorAll ? root : document).querySelectorAll('[data-env2-places]').forEach(init);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ boot(document); });
  else boot(document);
  document.addEventListener('shopify:section:load', function(e){ boot(e.target || document); });
  document.addEventListener('shopify:block:select', function(e){
    var b = e.target;
    if (!b || !b.closest || !b.closest('[data-env2-places]')) return;
    b.classList.add('lit');
    if (b.scrollIntoView) b.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "ElmsNest v2 — ארבעה מקומות",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "ארבעה מקומות. קטגוריה אחת." },
    { "type": "textarea", "id": "intro", "label": "פסקת פתיחה (בצד השמאלי של הכותרת)", "default": "אנחנו לא חנות תאורה. אנחנו חנות תאורת חוץ — ומתאימים כל מוצר למקום שבו הוא יעמוד." },
    { "type": "text", "id": "all_label", "label": "קישור לכל המוצרים", "default": "לכל [count] המוצרים", "info": "[count] מוחלף במספר המוצרים האמיתי בחנות." },
    { "type": "url", "id": "all_link", "label": "יעד הקישור", "default": "/collections/all" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "place",
      "name": "מקום",
      "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "קולקציה", "info": "התמונה, המספר והקישור נלקחים מהקולקציה. לחיתוך: קבעו נקודת מיקוד לתמונת הקולקציה בממשק הניהול." },
        { "type": "image_picker", "id": "image", "label": "תמונה חלופית (לא חובה)" },
        { "type": "text", "id": "title_short", "label": "שם קצר", "default": "שביל" },
        { "type": "text", "id": "subtitle", "label": "שורת משנה", "default": "שביל, עמוד וגינה" },
        {
          "type": "select", "id": "aspect", "label": "יחס תמונה",
          "options": [
            { "value": "5/4", "label": "5/4 — רוחבי" },
            { "value": "3/4.6", "label": "3/4.6 — גבוה" },
            { "value": "4/3.2", "label": "4/3.2 — רוחבי" },
            { "value": "3/4.1", "label": "3/4.1 — גבוה" }
          ],
          "default": "5/4"
        },
        { "type": "range", "id": "lift", "label": "הגבהה מהקו התחתון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "המדרגות: 0 / 60 / 24 / 100. במובייל ההגבהה מוקטנת אוטומטית." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ElmsNest v2 — ארבעה מקומות",
      "blocks": [
        { "type": "place", "settings": { "collection": "תאורת-שביל-סולארית", "title_short": "שביל", "subtitle": "שביל, עמוד וגינה", "aspect": "5/4", "lift": 0 } },
        { "type": "place", "settings": { "collection": "solar-wall-lights", "title_short": "קיר", "subtitle": "תאורת קיר", "aspect": "3/4.6", "lift": 60 } },
        { "type": "place", "settings": { "collection": "ספוטים-ופרוז-קטורים-סולאריים", "title_short": "גינה", "subtitle": "ספוטים, פרוז׳קטורים וניידים", "aspect": "4/3.2", "lift": 24 } },
        { "type": "place", "settings": { "collection": "גרילנדות-ותאורה-דקורטיבית", "title_short": "מרפסת", "subtitle": "גרילנדות ותאורה דקורטיבית", "aspect": "3/4.1", "lift": 100 } }
      ]
    }
  ]
}
{% endschema %}
