{%- comment -%}
  ElmsNest S — solar, how it works (HOME round 2 SPEC §1 A, amended after the critique — critique/LEAD-DECISIONS.md).
  Home only. A heading in the neighbours' scale («איך עובדת תאורה סולארית?» — the scope word at heading weight),
  then a two-frame figure grid: the day frame on the inline-start (right in RTL), the night frame on the
  inline-end, each with half of the headline on its foot («ביום נטען.» cream / «בלילה נדלק.» glow) on a bottom
  scrim. Under the frames ONE line on hairlines («בלי חיבור לחשמל, בלי חשמלאי.») — the two facts the frames do
  not say (the automatic switch-on is already the hero's sentence and the night headline). Corner labels exist as
  settings but are empty by default (the headlines already say day and night); when the owner types one it sits
  on a .85 night backing so it is legible on any photograph. No button, no link, no card chrome, no motion.
  Both photographs are the store's own product frames (assets/ens-home-day.jpg 1254x1254, assets/ens-home-night.jpg
  1254x1090, the latter pre-cropped so its baked caption is not in the file) — no credit owed. An owner-picked
  image_picker replaces the asset; object_position per frame and per breakpoint crops it.
  Tokens come from elmsnest-v2-core (global); this file only adds ens-home-solar* rules.
{%- endcomment -%}
{%- liquid
  assign ens_op_day = section.settings.object_position_day | default: '50% 50%' | strip | escape
  assign ens_op_day_lg = section.settings.object_position_day_desktop | default: '50% 40%' | strip | escape
  assign ens_op_night = section.settings.object_position_night | default: '50% 40%' | strip | escape
  assign ens_op_night_lg = section.settings.object_position_night_desktop | default: '50% 30%' | strip | escape
  assign ens_alt_day = section.settings.alt_day | default: '' | strip | escape
  assign ens_alt_night = section.settings.alt_night | default: '' | strip | escape
  comment
    Picker srcsets: the widths are capped against the source width here (image_tag does not
    drop oversize widths) — the hero's R26 rule. The theme assets below carry their native
    top width (1254w) instead of a false 1600w descriptor.
  endcomment
  assign ens_want = '600,900,1200,1600' | split: ','
  assign ens_w_day = ''
  for w in ens_want
    assign wn = w | plus: 0
    if section.settings.image_day != blank and wn <= section.settings.image_day.width
      if ens_w_day == ''
        assign ens_w_day = w
      else
        assign ens_w_day = ens_w_day | append: ',' | append: w
      endif
    endif
  endfor
  if ens_w_day == ''
    assign ens_w_day = '600'
  endif
  assign ens_w_night = ''
  for w in ens_want
    assign wn = w | plus: 0
    if section.settings.image_night != blank and wn <= section.settings.image_night.width
      if ens_w_night == ''
        assign ens_w_night = w
      else
        assign ens_w_night = ens_w_night | append: ',' | append: w
      endif
    endif
  endfor
  if ens_w_night == ''
    assign ens_w_night = '600'
  endif
-%}
<section class="env2-section ens-home-solar" dir="rtl"{% if section.settings.heading != blank %} aria-labelledby="ens-home-solar-h2-{{ section.id }}"{% else %} aria-label="תאורה סולארית"{% endif %} style="scroll-margin-top:90px">
  <div class="env2-wrap">
    {%- if section.settings.heading != blank -%}
    <h2 id="ens-home-solar-h2-{{ section.id }}" class="env2-h ens-home-solar__h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="ens-home-solar__frames">
      <figure class="ens-home-solar__frame ens-home-solar__frame--day" style="--ens-op:{{ ens_op_day }};--ens-op-lg:{{ ens_op_day_lg }}">
        {%- if section.settings.image_day != blank -%}
          {{ section.settings.image_day | image_url: width: 1600 | image_tag: loading: 'lazy', decoding: 'async', widths: ens_w_day, sizes: '(min-width:1300px) 620px, 50vw', alt: ens_alt_day }}
        {%- else -%}
          <img src="{{ 'ens-home-day.jpg' | asset_img_url: '1254x' }}" srcset="{{ 'ens-home-day.jpg' | asset_img_url: '600x' }} 600w, {{ 'ens-home-day.jpg' | asset_img_url: '900x' }} 900w, {{ 'ens-home-day.jpg' | asset_img_url: '1254x' }} 1254w" sizes="(min-width:1300px) 620px, 50vw" width="1254" height="1254" loading="lazy" decoding="async" alt="{{ ens_alt_day }}">
        {%- endif -%}
        {%- if section.settings.label_day != blank -%}
        <span class="ens-home-solar__tag">{{ section.settings.label_day | escape }}</span>
        {%- endif -%}
        {%- if section.settings.headline_day != blank -%}
        <p class="ens-home-solar__word">{{ section.settings.headline_day | escape }}</p>
        {%- endif -%}
      </figure>
      <figure class="ens-home-solar__frame ens-home-solar__frame--night" style="--ens-op:{{ ens_op_night }};--ens-op-lg:{{ ens_op_night_lg }}">
        {%- if section.settings.image_night != blank -%}
          {{ section.settings.image_night | image_url: width: 1600 | image_tag: loading: 'lazy', decoding: 'async', widths: ens_w_night, sizes: '(min-width:1300px) 620px, 50vw', alt: ens_alt_night }}
        {%- else -%}
          <img src="{{ 'ens-home-night.jpg' | asset_img_url: '1254x' }}" srcset="{{ 'ens-home-night.jpg' | asset_img_url: '600x' }} 600w, {{ 'ens-home-night.jpg' | asset_img_url: '900x' }} 900w, {{ 'ens-home-night.jpg' | asset_img_url: '1254x' }} 1254w" sizes="(min-width:1300px) 620px, 50vw" width="1254" height="1090" loading="lazy" decoding="async" alt="{{ ens_alt_night }}">
        {%- endif -%}
        {%- if section.settings.label_night != blank -%}
        <span class="ens-home-solar__tag">{{ section.settings.label_night | escape }}</span>
        {%- endif -%}
        {%- if section.settings.headline_night != blank -%}
        <p class="ens-home-solar__word">{{ section.settings.headline_night | escape }}</p>
        {%- endif -%}
      </figure>
    </div>
    {%- if section.settings.line_1 != blank or section.settings.line_2 != blank or section.settings.line_3 != blank -%}
    <ul class="ens-home-solar__lines" role="list">
      {%- if section.settings.line_1 != blank -%}
      <li class="ens-home-solar__line">{{ section.settings.line_1 | escape }}</li>
      {%- endif -%}
      {%- if section.settings.line_2 != blank -%}
      <li class="ens-home-solar__line">{{ section.settings.line_2 | escape }}</li>
      {%- endif -%}
      {%- if section.settings.line_3 != blank -%}
      <li class="ens-home-solar__line">{{ section.settings.line_3 | escape }}</li>
      {%- endif -%}
    </ul>
    {%- endif -%}
  </div>
</section>

<style>
.ens-home-solar{padding-block:40px 40px;margin:0}
.ens-home-solar__h2.env2-h{font-size:clamp(25px,3.4vw,44px);line-height:1.1;margin:0 0 18px}
.ens-home-solar__frames{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;background:#020306}
.ens-home-solar__frame{position:relative;margin:0;min-width:0;aspect-ratio:4/5;overflow:hidden;background:#05070c;border-radius:0;isolation:isolate}
/* crop per frame and per breakpoint (object_position settings); an admin focal point written inline by image_tag still wins */
.ens-home-solar__frame img{display:block;inline-size:100%;block-size:100%;object-fit:cover;object-position:var(--ens-op,50% 50%)}
/* bottom scrims: the night frame is already dark, its scrim only lifts the glow headline past 4.5:1 on the lamp-lit pavement (measured 6.4:1 at 360); the day frame is bright, so its scrim starts later and ends at .78 */
.ens-home-solar__frame::after{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(180deg,rgba(5,8,14,0) 36%,rgba(5,8,14,.84) 100%)}
.ens-home-solar__frame--day::after{background:linear-gradient(180deg,transparent 45%,rgba(5,8,14,.78) 100%)}
/* corner label (off by default): a night backing, so a word the owner types is legible on any photograph (14:1 measured on the day frame) */
.ens-home-solar__tag{position:absolute;inset-inline-end:8px;inset-block-start:8px;z-index:1;margin:0;padding:4px 8px;background:rgba(5,8,14,.85);font-family:var(--env2-sans);font-weight:400;font-size:12px;line-height:1.3;letter-spacing:.06em;color:var(--env2-ink)}
.ens-home-solar__word{position:absolute;inset-inline:12px;inset-block-end:12px;z-index:1;margin:0;font-family:var(--env2-serif);font-weight:700;font-size:28px;line-height:1.02;letter-spacing:-.01em;color:var(--env2-ink);text-shadow:0 1px 18px rgba(2,3,6,.6);text-wrap:balance}
.ens-home-solar__frame--night .ens-home-solar__word{color:var(--env2-glow)}
.ens-home-solar__lines{list-style:none;margin:22px 0 0;padding:0;border-block-end:1px solid #1f1e1d}
.ens-home-solar__line{margin:0;padding-block:12px;border-block-start:1px solid #1f1e1d;font-family:var(--env2-sans);font-weight:400;font-size:16px;line-height:1.45;color:var(--env2-ink);text-wrap:pretty}
@media (min-width:901px){
  .ens-home-solar{padding-block:72px 56px}
  .ens-home-solar__h2.env2-h{margin-block-end:26px}
  .ens-home-solar__frame{aspect-ratio:16/10}
  .ens-home-solar__frame img{object-position:var(--ens-op-lg,50% 40%)}
  .ens-home-solar__tag{inset-inline-end:16px;inset-block-start:16px}
  .ens-home-solar__word{inset-inline:28px;inset-block-end:24px;font-size:44px}
  .ens-home-solar__lines{margin-block-start:28px}
  .ens-home-solar__line{padding-block:16px;font-size:17px}
}
@media (prefers-reduced-motion:reduce){
  .ens-home-solar img{transition:none}
}
</style>

{% schema %}
{
  "name": "ElmsNest S — סולארי",
  "class": "ens-home-section hdt-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "איך עובדת תאורה סולארית?" },
    { "type": "header", "content": "מסגרת היום (בצד ימין)" },
    { "type": "image_picker", "id": "image_day", "label": "תמונת היום (ריק = ens-home-day.jpg)" },
    { "type": "text", "id": "object_position_day", "label": "מיקום החיתוך בנייד — יום (object-position)", "default": "50% 50%", "info": "לדוגמה 30% 50% כדי להצמיד לצד התמונה. נקודת מיקוד מממשק הניהול גוברת." },
    { "type": "text", "id": "object_position_day_desktop", "label": "מיקום החיתוך במחשב — יום", "default": "50% 40%", "info": "חל מרוחב 901 פיקסלים (המסגרת רחבה יותר שם)." },
    { "type": "text", "id": "headline_day", "label": "כותרת על מסגרת היום", "default": "ביום נטען." },
    { "type": "text", "id": "label_day", "label": "תווית פינה — יום", "info": "ריק = בלי תווית (הכותרת על המסגרת כבר אומרת «יום»)." },
    { "type": "text", "id": "alt_day", "label": "טקסט חלופי לתמונת היום (alt)", "info": "ריק = תמונה דקורטיבית; הטקסט על המסגרת נושא את המשמעות." },
    { "type": "header", "content": "מסגרת הלילה (בצד שמאל)" },
    { "type": "image_picker", "id": "image_night", "label": "תמונת הלילה (ריק = ens-home-night.jpg)" },
    { "type": "text", "id": "object_position_night", "label": "מיקום החיתוך בנייד — לילה (object-position)", "default": "50% 40%", "info": "לדוגמה 70% 30% כדי להצמיד לצד התמונה. נקודת מיקוד מממשק הניהול גוברת." },
    { "type": "text", "id": "object_position_night_desktop", "label": "מיקום החיתוך במחשב — לילה", "default": "50% 30%", "info": "חל מרוחב 901 פיקסלים." },
    { "type": "text", "id": "headline_night", "label": "כותרת על מסגרת הלילה", "default": "בלילה נדלק." },
    { "type": "text", "id": "label_night", "label": "תווית פינה — לילה", "info": "ריק = בלי תווית." },
    { "type": "text", "id": "alt_night", "label": "טקסט חלופי לתמונת הלילה (alt)", "info": "ריק = תמונה דקורטיבית." },
    { "type": "header", "content": "השורות מתחת למסגרות" },
    { "type": "text", "id": "line_1", "label": "שורה ראשונה", "default": "בלי חיבור לחשמל, בלי חשמלאי." },
    { "type": "text", "id": "line_2", "label": "שורה שנייה", "info": "ריק = בלי שורה." },
    { "type": "text", "id": "line_3", "label": "שורה שלישית", "info": "ריק = בלי שורה." }
  ],
  "presets": [
    {
      "name": "ElmsNest S — סולארי"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
