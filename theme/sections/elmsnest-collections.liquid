{%- comment -%}
  ElmsNest collections — rebuild 2026-09-01.

  Replaces sections/elmsnest-home-shop.liquid, which listed the same four
  collections but gave each one a paragraph. Four paragraphs of guidance on a
  browsing row is how the old page ran to 6673px: the words were fine, there
  were just far too many of them for a control whose whole job is «which of
  these four is mine?».

  Each tile now carries one line. The collection photographs are night scenes
  and they are what actually distinguishes «שביל» from «קיר» at a glance —
  so the image gets the height and the copy gets a single clause. The longer
  guidance still exists one section down, where a buyer who wants it is
  looking for it.

  A collection with no image falls back to its first product's image rather
  than an empty plate, and a collection with no products is skipped entirely.
{%- endcomment -%}

<section id="elmsnest-collections" class="en-cols" dir="rtl" aria-labelledby="en-cols-title-{{ section.id }}">
  <div class="en-cols__wrap">

    <header class="en-cols__head">
      <h2 class="en-cols__title" id="en-cols-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="en-cols__lede">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <ul class="en-cols__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign art = col.featured_image | default: col.products.first.featured_image
        -%}
        {%- if col != blank and col.products_count > 0 -%}
          <li class="en-col" {{ block.shopify_attributes }}>
            <a class="en-col__link" href="{{ col.url }}">
              <span class="en-col__media">
                {%- if art -%}
                  {{ art
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,450,600,700',
                      sizes: '(max-width:749px) 92vw, (max-width:1099px) 46vw, 24vw',
                      alt: ''
                  }}
                {%- endif -%}
                <span class="en-col__veil" aria-hidden="true"></span>
              </span>
              <span class="en-col__body">
                <span class="en-col__name">{{ block.settings.label | default: col.title }}</span>
                {%- if block.settings.line != blank -%}
                  <span class="en-col__line">{{ block.settings.line }}</span>
                {%- endif -%}
                <span class="en-col__count">
                  <bdi dir="ltr">{{ col.products_count }}</bdi> {{ section.settings.count_word }}
                  <span class="en-col__go" aria-hidden="true">←</span>
                </span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
.en-cols,.en-cols *{box-sizing:border-box}
.en-cols{
  --night:var(--en-night,43 33 24);
  --ink:var(--en-ink,247 240 230);
  --gold:var(--en-gold,217 173 95);
  direction:rtl;padding:clamp(52px,6.4vw,84px) 0;
  background:rgb(var(--night));color:rgb(var(--ink));
  scroll-margin-top:90px
}
.en-cols__wrap{width:min(1200px,100%);margin-inline:auto;padding-inline:clamp(18px,4vw,40px)}

.en-cols__head{max-width:44rem;margin-bottom:clamp(24px,3.2vw,36px)}
.en-cols__title{
  margin:0;color:rgb(var(--ink))!important;
  font-size:clamp(28px,4.2vw,46px);line-height:1.1;letter-spacing:normal;text-wrap:balance
}
.en-cols__lede{margin:12px 0 0;color:rgb(var(--ink)/.76);font-size:clamp(15px,1.7vw,17px);line-height:1.5}

.en-cols__grid{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:clamp(14px,1.8vw,22px);margin:0;padding:0;list-style:none
}
.en-col{min-width:0}
.en-col__link{display:flex;flex-direction:column;height:100%;color:rgb(var(--ink))!important;text-decoration:none}

.en-col__media{
  position:relative;display:block;overflow:hidden;
  aspect-ratio:4/5;background:rgb(var(--ink)/.06);
  border:1px solid rgb(var(--ink)/.18);
  transition:border-color .2s ease
}
.en-col__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
/* The veil is warm, not black: it darkens the top of the frame enough to keep
   a bright sky from fighting the row, while the gold cast keeps the tile in
   the same light the hero establishes. */
.en-col__veil{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgb(var(--night)/.55) 0%,rgb(var(--night)/0) 48%),
             radial-gradient(70% 60% at 50% 88%,rgb(var(--gold)/.14) 0%,transparent 70%)
}
.en-col__link:hover .en-col__media{border-color:rgb(var(--gold)/.75)}
.en-col__link:hover .en-col__media img{transform:scale(1.05)}
.en-col__link:focus-visible .en-col__media{outline:3px solid rgb(var(--gold));outline-offset:2px}

.en-col__body{display:flex;flex-direction:column;gap:6px;padding-block-start:14px;flex:1}
.en-col__name{font-size:clamp(17px,1.9vw,20px);font-weight:700;line-height:1.25;text-wrap:balance}
.en-col__line{color:rgb(var(--ink)/.72);font-size:14px;line-height:1.45}
.en-col__count{
  display:flex;align-items:center;gap:8px;margin-block-start:auto;padding-block-start:10px;
  color:rgb(var(--ink)/.55);font-size:13px;font-variant-numeric:tabular-nums
}
.en-col__go{margin-inline-start:auto;color:rgb(var(--gold));font-size:16px;transition:transform .2s ease}
.en-col__link:hover .en-col__go{transform:translateX(-4px)}

@media(max-width:1099px){.en-cols__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:749px){
  .en-cols__wrap{padding-inline:16px}
  .en-cols__grid{grid-template-columns:1fr;gap:14px}
  /* One column, so the tile turns on its side: the photograph stays large
     enough to tell the four apart without four full-bleed screens of scroll. */
  .en-col__link{flex-direction:row;align-items:stretch;gap:14px}
  .en-col__media{flex:0 0 40%;aspect-ratio:1/1}
  .en-col__body{padding-block-start:2px;padding-block-end:2px;justify-content:center}
}
@media(prefers-reduced-motion:reduce){
  .en-col__media img,.en-col__go,.en-col__media{transition:none}
  .en-col__link:hover .en-col__media img{transform:none}
  .en-col__link:hover .en-col__go{transform:none}
}
{% endstylesheet %}

{% schema %}
{
  "name": "ElmsNest collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "לפי המקום שרוצים להאיר" },
    { "type": "text", "id": "intro", "label": "משפט תומך", "default": "ארבע קטגוריות, לפי איפה גוף התאורה יעמוד בפועל." },
    { "type": "text", "id": "count_word", "label": "מילת הספירה", "default": "מוצרים" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "קטגוריה",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "קולקציה" },
        { "type": "text", "id": "label", "label": "שם להצגה", "info": "ברירת מחדל: שם הקולקציה" },
        { "type": "text", "id": "line", "label": "שורה אחת", "info": "משפט קצר בלבד — ההסבר המלא נמצא בסעיף «איפה צריך אור?»" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ElmsNest collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
